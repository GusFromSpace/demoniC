# A `@grad` fitting loop that RUNS end to end under `dmc jit`.
#
# The other JIT-autodiff examples here — `attn_grad_jit.dmc`,
# `softmax_grad_jit.dmc`, `activations_grad_jit.dmc` — have no `fn main`, so
# `dmc jit examples/…` never executes them; they are exercised by the
# compiler's own unit tests instead. That makes the path look better covered
# from the outside than it is runnable. This example is the missing smoke
# test: a `main` that actually fits, so the whole chain (lower `@grad`, call
# `.fwd_bwd`, destructure the `(loss, grads)` tuple, update the parameters,
# loop) is a gate you can run from a shell.
#
# It also pins a real regression. The loss below scales its squared error by a
# bare `0.5` — an unsuffixed float literal, which is f64 in the JIT. That put a
# non-f32 value on the f32 reverse tape, so the backward's `d(a·b)/da = adj·b`
# emitted `fmul` across two float widths and Cranelift rejected the whole
# `$fwd_bwd` with a bare "Verifier errors". Writing `0.5` rather than `0.5f32`
# here is deliberate: it is the shape that used to fail, and it is the shape
# anyone writes by default.
#
# Everything is concrete-shaped — the JIT does not monomorphize a shape-generic
# `@grad fn` backward, so `Tensor[f32, [N]]` here would fall back to the
# interpreter — and stays inside the differentiable subset, so interp and JIT
# agree.

# ── the model ───────────────────────────────────────────────────────────────
#
#   pred = w @ x   over 4 samples ;  loss = ½·mean((pred − y)²)
#
# The three rows of `x` are mutually orthogonal with equal norm, so the loss
# Hessian is exactly the identity: gradient descent at lr = 0.5 halves the
# parameter error every step. That is not incidental — an ill-conditioned
# design makes "did it converge?" a question about step counts and tolerances
# instead of about the gradient being right, which is what this example is for.
@grad fn fit_loss(!w: Tensor[f32, [1, 3]],
                  x: Tensor[f32, [3, 4]],
                  y: Tensor[f32, [1, 4]]) -> f32 {
    let pred = w @ x
    let d = pred .- y
    mean(d .* d) * 0.5
}

fn design() -> Tensor[f32, [3, 4]] {
    [[1.0f32,  1.0f32,  1.0f32,  1.0f32],
     [1.0f32, -1.0f32,  1.0f32, -1.0f32],
     [1.0f32,  1.0f32, -1.0f32, -1.0f32]]
}

# Generated by w* = [2, −1, ½], so the fit has an exact optimum to walk to.
fn target() -> Tensor[f32, [1, 4]] {
    [[1.5f32, 3.5f32, 0.5f32, 2.5f32]]
}

# ── the fitting loop ────────────────────────────────────────────────────────
fn fit(steps: i64) -> Tensor[f32, [1, 3]] {
    let x = design()
    let y = target()
    let !w = forge.zeros[f32, [1, 3]]
    for _step in 0..steps {
        let (_l, g) = fit_loss.fwd_bwd(w, x, y)
        w = w .- (g.w .* 0.5)
    }
    w
}

# ── tests ───────────────────────────────────────────────────────────────────

# At w = 0 the prediction is 0, so d = −y and dL/dw_j = −¼·(y·x_j):
#   j=0: −¼·(1.5 + 3.5 + 0.5 + 2.5) = −¼·8  = −2
#   j=1: −¼·(1.5 − 3.5 + 0.5 − 2.5) = −¼·−4 = +1
#   j=2: −¼·(1.5 + 3.5 − 0.5 − 2.5) = −¼·2  = −0.5
# — which is exactly −w*, as it must be when the Hessian is the identity.
# The loss is ½·mean(y²) = ½·(2.25 + 12.25 + 0.25 + 6.25)/4 = 2.625.
fn test_grad_matches_analytic() -> bool {
    let x = design()
    let y = target()
    let !w = forge.zeros[f32, [1, 3]]
    let (l, g) = fit_loss.fwd_bwd(w, x, y)
    (l > 2.6245) && (l < 2.6255)
        && (g.w[0,0] > 0.0-2.0005) && (g.w[0,0] < 0.0-1.9995)
        && (g.w[0,1] > 0.9995)     && (g.w[0,1] < 1.0005)
        && (g.w[0,2] > 0.0-0.5005) && (g.w[0,2] < 0.0-0.4995)
}

# Descent must actually descend. Each step halves the parameter error, so 12
# steps cut the loss by ~2²⁴; asserted loosely — the point is convergence, not
# a golden float.
fn test_fit_reduces_the_loss() -> bool {
    let x = design()
    let y = target()
    let !w0 = forge.zeros[f32, [1, 3]]
    let (before, _g0) = fit_loss.fwd_bwd(w0, x, y)
    let !wn = fit(12)
    let (after, _gn) = fit_loss.fwd_bwd(wn, x, y)
    (before > 2.62) && (after >= 0.0) && (after < 0.0001)
}

# …and it walks to the generating parameters, not merely to some low loss.
fn test_fit_recovers_the_true_weights() -> bool {
    let !w = fit(30)
    (w[0,0] > 1.999) && (w[0,0] < 2.001)
        && (w[0,1] > 0.0-1.001) && (w[0,1] < 0.0-0.999)
        && (w[0,2] > 0.499)     && (w[0,2] < 0.501)
}

# The unsuffixed-literal case in isolation: a traced scalar times a bare `2.0`.
# L = sum(w)·2.0 has dL/dw = 2 everywhere. Before the fix this did not return a
# wrong answer — it refused to compile, and took the enclosing program with it.
@grad fn scaled_sum(!w: Tensor[f32, [3]]) -> f32 {
    let s = sum(w)
    s * 2.0
}

fn test_unsuffixed_literal_scales_the_gradient() -> bool {
    let !w = forge.zeros[f32, [3]]
    w[0] = 1.0  w[1] = 2.0  w[2] = 3.0
    let (l, g) = scaled_sum.fwd_bwd(w)
    (l > 11.999) && (l < 12.001)
        && (g.w[0] > 1.999) && (g.w[0] < 2.001)
        && (g.w[2] > 1.999) && (g.w[2] < 2.001)
}

fn main() {
    print("grad matches analytic:")   print(test_grad_matches_analytic())
    print("fit reduces the loss:")    print(test_fit_reduces_the_loss())
    print("fit recovers weights:")    print(test_fit_recovers_the_true_weights())
    print("unsuffixed literal ok:")   print(test_unsuffixed_literal_scales_the_gradient())
}
