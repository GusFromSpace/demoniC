# dv2.dmc — demoniVM-2, a tiny fantasy console (milestone M0 + INPUT).
#
# Tests below verify the core VM opcode logic in isolation (no terminal I/O).
#
# A stack-machine CPU with 16 memory slots drives a [20x32] integer VRAM
# framebuffer. Programs run forever; the VSYNC opcode is the heartbeat.
#
# ── ISA ────────────────────────────────────────────────────────────────────
#   0 HALT
#   1 PUSH  imm      push next byte
#   2 ADD   3 SUB   4 MUL          (pop b, pop a, push a∘b)
#   5 NEG            (pop a, push -a)
#   6 EQ    7 LT    8 GT           (pop b, pop a, push 1/0)
#   9 JMP   addr     jump (absolute)
#  10 JZ    addr     pop; if zero, jump
#  11 LOAD  slot     push mem[slot]
#  12 STORE slot     pop into mem[slot]
#  13 DUP            duplicate top
#  14 CLS   imm      clear VRAM to color imm
#  15 PSET           pop c, pop y, pop x; VRAM[y,x] = c
#  16 VSYNC          blit frame; halt at the cap
#  17 DRAW3D         raymarch the scene into VRAM (see raycart.dmc)
#  18 INPUT          push most recent key as char code (0 = none)

let ESC = chr(27)
let CLEAR = ESC + "[2J" + ESC + "[H"

fn run[P](code: Tensor[u8, [P]], maxframes: i64) -> nil {
    let !fb    = forge.zeros[i64, [20, 32]]
    let !mem   = forge.zeros[i64, [16]]
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0
    let !pc = 0
    let !frame = 0
    let !running = true
    let !last_key = 0   # most recent INPUT result (char code, 0 = none)

    set_raw_mode(true)
    while running {
        let op = code[pc]
        pc = pc + 1

        if op == 0 { running = false }
        if op == 1 {                       # PUSH
            let imm = code[pc]
            pc = pc + 1
            stack[sp] = imm
            sp = sp + 1
        }
        if op == 2 {                       # ADD
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            stack[sp] = a + b
            sp = sp + 1
        }
        if op == 3 {                       # SUB
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            stack[sp] = a - b
            sp = sp + 1
        }
        if op == 4 {                       # MUL
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            stack[sp] = a * b
            sp = sp + 1
        }
        if op == 5 {                       # NEG
            let a = stack[sp - 1]
            sp = sp - 1
            stack[sp] = 0 - a
            sp = sp + 1
        }
        if op == 6 {                       # EQ
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            if a == b { stack[sp] = 1 } else { stack[sp] = 0 }
            sp = sp + 1
        }
        if op == 7 {                       # LT
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            if a < b { stack[sp] = 1 } else { stack[sp] = 0 }
            sp = sp + 1
        }
        if op == 8 {                       # GT
            let b = stack[sp - 1]
            let a = stack[sp - 2]
            sp = sp - 2
            if a > b { stack[sp] = 1 } else { stack[sp] = 0 }
            sp = sp + 1
        }
        if op == 9 {                       # JMP
            pc = code[pc]
        }
        if op == 10 {                      # JZ
            let addr = code[pc]
            pc = pc + 1
            sp = sp - 1
            if stack[sp] == 0 { pc = addr }
        }
        if op == 11 {                      # LOAD
            let slot = code[pc]
            pc = pc + 1
            stack[sp] = mem[slot]
            sp = sp + 1
        }
        if op == 12 {                      # STORE
            let slot = code[pc]
            pc = pc + 1
            sp = sp - 1
            mem[slot] = stack[sp]
        }
        if op == 13 {                      # DUP
            stack[sp] = stack[sp - 1]
            sp = sp + 1
        }
        if op == 14 {                      # CLS
            let c = code[pc]
            pc = pc + 1
            if c == 0 {
                fb = forge.zeros[i64, [20, 32]]
            } else {
                let !ry = 0
                while ry < 20 {
                    let !cx = 0
                    while cx < 32 { fb[ry, cx] = c; cx = cx + 1 }
                    ry = ry + 1
                }
            }
        }
        if op == 15 {                      # PSET  (x y c --)
            let c = stack[sp - 1]
            let y = stack[sp - 2]
            let x = stack[sp - 3]
            sp = sp - 3
            fb[y, x] = c
        }
        if op == 16 {                      # VSYNC
            # Non-blocking key poll — cart reads it via INPUT next iteration
            let k = read_char_nb()
            if len(k) > 0 { last_key = ord(k) } else { last_key = 0 }

            # Animated blit: clear terminal, redraw in place
            print(CLEAR + format("demoniVM-2  frame {}  (q=quit wasd=move)", frame))
            print("+--------------------------------+")
            let !ry = 0
            while ry < 20 {
                let !row = "|"
                let !cx = 0
                while cx < 32 {
                    let v = fb[ry, cx]
                    if v == 0 { row = row + " " }
                    if v == 1 { row = row + "." }
                    if v == 2 { row = row + "o" }
                    if v == 3 { row = row + "O" }
                    if v == 4 { row = row + "#" }
                    cx = cx + 1
                }
                row = row + "|"
                print(row)
                ry = ry + 1
            }
            print("+--------------------------------+")
            flush()
            sleep_ms(80)
            frame = frame + 1
            if frame >= maxframes { running = false }

            # q quits immediately
            if last_key == 113 { running = false }
        }
        if op == 18 {                      # INPUT — push last key code (0=none)
            stack[sp] = last_key
            sp = sp + 1
        }
    }
    set_raw_mode(false)
    print(CLEAR)
    nil
}

fn main() -> nil {
    print("demoniVM-2 // boot // cart: BOUNCE")

    # BOUNCE — a ball ricochets inside the 32x20 screen.
    #   mem: 0=ballx 1=bally 2=vx 3=vy
    let cart = [
        1u8,28u8, 12u8,0u8,  1u8,16u8, 12u8,1u8,  1u8,1u8, 12u8,2u8,  1u8,1u8, 12u8,3u8,
        14u8,0u8,
        11u8,0u8, 11u8,2u8, 2u8, 12u8,0u8,
        11u8,0u8, 1u8,1u8, 7u8, 10u8,36u8, 1u8,1u8, 12u8,2u8,
        11u8,0u8, 1u8,30u8, 8u8, 10u8,48u8, 1u8,1u8, 5u8, 12u8,2u8,
        11u8,1u8, 11u8,3u8, 2u8, 12u8,1u8,
        11u8,1u8, 1u8,1u8, 7u8, 10u8,66u8, 1u8,1u8, 12u8,3u8,
        11u8,1u8, 1u8,18u8, 8u8, 10u8,78u8, 1u8,1u8, 5u8, 12u8,3u8,
        11u8,0u8, 11u8,1u8, 1u8,3u8, 15u8,
        16u8,
        9u8,16u8
    ]
    run[88](cart, 999)
    nil
}

# ── Tests ──────────────────────────────────────────────────────────────────────
# Each test simulates VM opcode logic inline (no terminal I/O) and checks a
# closed-form invariant that is independently justified below.

# test_push_add_sub_mul: simulate PUSH/ADD/SUB/MUL opcodes on a local stack.
# Ground truth: arithmetic is exact integer operations.
#   PUSH 7, PUSH 5 → ADD → 12    (7+5)
#   PUSH 12, PUSH 3 → SUB → 9   (12-3) — stack is: [12, 3] so a=12,b=3 → 12-3=9
#   PUSH 4, PUSH 9 → MUL → 36   (4*9)  — but stack has [9,4] so a=9,b=4 → 36 same
# The VM pops b=top, a=below; ADD/SUB/MUL are (a op b), i.e. left-operand is deeper.
fn test_push_add_sub_mul() -> bool {
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # PUSH 7
    stack[sp] = 7
    sp = sp + 1
    # PUSH 5
    stack[sp] = 5
    sp = sp + 1
    # ADD: pop b=5, pop a=7, push 12
    let add_b = stack[sp - 1]
    let add_a = stack[sp - 2]
    sp = sp - 2
    stack[sp] = add_a + add_b
    sp = sp + 1
    let add_result = stack[sp - 1]  # 7 + 5 = 12

    # PUSH 3
    stack[sp] = 3
    sp = sp + 1
    # SUB: pop b=3, pop a=12, push 9
    let sub_b = stack[sp - 1]
    let sub_a = stack[sp - 2]
    sp = sp - 2
    stack[sp] = sub_a - sub_b
    sp = sp + 1
    let sub_result = stack[sp - 1]  # 12 - 3 = 9

    # PUSH 4
    stack[sp] = 4
    sp = sp + 1
    # MUL: pop b=4, pop a=9, push 36
    let mul_b = stack[sp - 1]
    let mul_a = stack[sp - 2]
    sp = sp - 2
    stack[sp] = mul_a * mul_b
    sp = sp + 1
    let mul_result = stack[sp - 1]  # 9 * 4 = 36

    add_result == 12 && sub_result == 9 && mul_result == 36
}

# test_neg: simulate NEG opcode.
# Ground truth: NEG pops a, pushes (0 - a). NEG of 5 = -5; NEG of -3 = 3.
fn test_neg() -> bool {
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # NEG of 5
    stack[sp] = 5
    sp = sp + 1
    let neg_a = stack[sp - 1]
    sp = sp - 1
    stack[sp] = 0 - neg_a
    sp = sp + 1
    let neg5 = stack[sp - 1]  # -5

    # NEG of -3 (push negative value, then NEG)
    stack[sp] = 0 - 3         # push -3
    sp = sp + 1
    let neg_b = stack[sp - 1]
    sp = sp - 1
    stack[sp] = 0 - neg_b
    sp = sp + 1
    let neg_neg3 = stack[sp - 1]  # 3

    neg5 == (0 - 5) && neg_neg3 == 3
}

# test_compare_ops: simulate EQ/LT/GT opcodes.
# Ground truth: comparisons yield 1 (true) or 0 (false) from known integer pairs.
#   EQ(4,4)=1; EQ(4,5)=0; LT(3,7)=1; LT(7,3)=0; GT(9,2)=1; GT(2,9)=0
fn test_compare_ops() -> bool {
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # EQ: push 4, push 4, compare → 1
    stack[sp] = 4; sp = sp + 1
    stack[sp] = 4; sp = sp + 1
    let eq_b = stack[sp - 1]; let eq_a = stack[sp - 2]; sp = sp - 2
    if eq_a == eq_b { stack[sp] = 1 } else { stack[sp] = 0 }
    sp = sp + 1
    let eq_same = stack[sp - 1]   # 1

    # EQ: push 4, push 5, compare → 0
    stack[sp] = 4; sp = sp + 1
    stack[sp] = 5; sp = sp + 1
    let eq2_b = stack[sp - 1]; let eq2_a = stack[sp - 2]; sp = sp - 2
    if eq2_a == eq2_b { stack[sp] = 1 } else { stack[sp] = 0 }
    sp = sp + 1
    let eq_diff = stack[sp - 1]  # 0

    # LT: push 3, push 7 → a=3, b=7, 3<7 → 1
    stack[sp] = 3; sp = sp + 1
    stack[sp] = 7; sp = sp + 1
    let lt_b = stack[sp - 1]; let lt_a = stack[sp - 2]; sp = sp - 2
    if lt_a < lt_b { stack[sp] = 1 } else { stack[sp] = 0 }
    sp = sp + 1
    let lt_true = stack[sp - 1]  # 1

    # GT: push 9, push 2 → a=9, b=2, 9>2 → 1
    stack[sp] = 9; sp = sp + 1
    stack[sp] = 2; sp = sp + 1
    let gt_b = stack[sp - 1]; let gt_a = stack[sp - 2]; sp = sp - 2
    if gt_a > gt_b { stack[sp] = 1 } else { stack[sp] = 0 }
    sp = sp + 1
    let gt_true = stack[sp - 1]  # 1

    eq_same == 1 && eq_diff == 0 && lt_true == 1 && gt_true == 1
}

# test_framebuffer_pset: simulate PSET opcode (fb[y,x] = c).
# Ground truth: after writing a known color to a known (y,x) coordinate, reading
# back fb[y,x] must return exactly that color. CLS 0 guarantees the rest is zero.
fn test_framebuffer_pset() -> bool {
    let !fb = forge.zeros[i64, [20, 32]]
    # PSET: x=10, y=5, c=3 (color 'O' in the renderer)
    # fb is zero-initialized by forge.zeros; we write only one pixel
    fb[5, 10] = 3
    # The written cell must equal 3; an unwritten cell must still be 0
    let written = fb[5, 10]
    let unwritten = fb[0, 0]
    written == 3 && unwritten == 0
}

# test_cls_fill: simulate CLS opcode with nonzero color.
# Ground truth: after filling all cells with color 2, every cell in the 20×32
# framebuffer must equal 2 (checked by summing: 20*32*2 = 1280).
fn test_cls_fill() -> bool {
    let !fb = forge.zeros[i64, [20, 32]]
    # Fill all cells (CLS c=2)
    let !ry = 0
    while ry < 20 {
        let !cx = 0
        while cx < 32 { fb[ry, cx] = 2; cx = cx + 1 }
        ry = ry + 1
    }
    # All cells should be 2; sum = 20*32*2 = 1280
    let total = sum(fb)
    total == 1280
}

# test_dup: simulate DUP opcode.
# Ground truth: DUP copies the top stack element without consuming it; both
# copies must be equal to the original value pushed.
fn test_dup() -> bool {
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # PUSH 42
    stack[sp] = 42
    sp = sp + 1
    # DUP: copy stack[sp-1] into stack[sp], increment sp
    stack[sp] = stack[sp - 1]
    sp = sp + 1

    let top = stack[sp - 1]   # should be 42
    let second = stack[sp - 2] # should also be 42
    top == 42 && second == 42 && sp == 2
}

# test_mem_store_load: simulate STORE/LOAD opcodes.
# Ground truth: storing value V into slot S then loading slot S must recover V.
# Storing to different slots must be independent (no aliasing).
fn test_mem_store_load() -> bool {
    let !mem   = forge.zeros[i64, [16]]
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # PUSH 99, STORE slot=7
    stack[sp] = 99; sp = sp + 1
    let slot_a = 7
    sp = sp - 1
    mem[slot_a] = stack[sp]

    # PUSH 55, STORE slot=3
    stack[sp] = 55; sp = sp + 1
    let slot_b = 3
    sp = sp - 1
    mem[slot_b] = stack[sp]

    # LOAD slot=7
    stack[sp] = mem[slot_a]; sp = sp + 1
    let loaded_a = stack[sp - 1]  # 99

    # LOAD slot=3
    stack[sp] = mem[slot_b]; sp = sp + 1
    let loaded_b = stack[sp - 1]  # 55

    loaded_a == 99 && loaded_b == 55
}

# test_bounce_init: verify the BOUNCE cart's initialization sequence.
# The first 8 instructions push initial ball position and velocity into mem slots:
#   mem[0]=28 (ballx), mem[1]=16 (bally), mem[2]=1 (vx), mem[3]=1 (vy)
# Ground truth: the bytecodes are literally `PUSH imm, STORE slot` pairs.
fn test_bounce_init() -> bool {
    let !mem   = forge.zeros[i64, [16]]
    let !stack = forge.zeros[i64, [32]]
    let !sp = 0

    # PUSH 28u8=28, STORE 0u8=0
    stack[sp] = 28; sp = sp + 1; sp = sp - 1; mem[0] = stack[sp]
    # PUSH 16u8=16, STORE 1u8=1
    stack[sp] = 16; sp = sp + 1; sp = sp - 1; mem[1] = stack[sp]
    # PUSH 1, STORE 2
    stack[sp] = 1; sp = sp + 1; sp = sp - 1; mem[2] = stack[sp]
    # PUSH 1, STORE 3
    stack[sp] = 1; sp = sp + 1; sp = sp - 1; mem[3] = stack[sp]

    # Then the first step: LOAD 0 (ballx=28), LOAD 2 (vx=1), ADD, STORE 0 → ballx=29
    stack[sp] = mem[0]; sp = sp + 1
    stack[sp] = mem[2]; sp = sp + 1
    let mv_b = stack[sp-1]; let mv_a = stack[sp-2]; sp = sp - 2
    stack[sp] = mv_a + mv_b; sp = sp + 1
    sp = sp - 1; mem[0] = stack[sp]

    mem[0] == 29 && mem[1] == 16 && mem[2] == 1 && mem[3] == 1
}
