# asm.dmc — demoniVM-2 M1 assembler
#
# Two-pass assembler: readable assembly text → byte list.
#
# Syntax:
#   OPCODE [operand]    — one instruction per token group
#   label:              — defines a label at this byte position
#   # comment           — rest of line ignored
#
# Operand types:
#   PUSH/CLS imm        — integer literal (0-255)
#   JMP/JZ   label      — label name (resolved to byte offset)
#   LOAD/STORE slot     — integer slot OR named slot (auto-assigned 0-15)

pub fn asm_compile(src: str) -> list {
    let !opcode_map = map()
    opcode_map = map_set(opcode_map, "HALT",   0)
    opcode_map = map_set(opcode_map, "PUSH",   1)
    opcode_map = map_set(opcode_map, "ADD",    2)
    opcode_map = map_set(opcode_map, "SUB",    3)
    opcode_map = map_set(opcode_map, "MUL",    4)
    opcode_map = map_set(opcode_map, "NEG",    5)
    opcode_map = map_set(opcode_map, "EQ",     6)
    opcode_map = map_set(opcode_map, "LT",     7)
    opcode_map = map_set(opcode_map, "GT",     8)
    opcode_map = map_set(opcode_map, "JMP",    9)
    opcode_map = map_set(opcode_map, "JZ",    10)
    opcode_map = map_set(opcode_map, "LOAD",  11)
    opcode_map = map_set(opcode_map, "STORE", 12)
    opcode_map = map_set(opcode_map, "DUP",   13)
    opcode_map = map_set(opcode_map, "CLS",   14)
    opcode_map = map_set(opcode_map, "PSET",  15)
    opcode_map = map_set(opcode_map, "VSYNC", 16)
    opcode_map = map_set(opcode_map, "DRAW3D",17)
    opcode_map = map_set(opcode_map, "INPUT", 18)

    # opcodes that take one operand byte after them
    let !has_operand = map()
    has_operand = map_set(has_operand, "PUSH",  true)
    has_operand = map_set(has_operand, "JMP",   true)
    has_operand = map_set(has_operand, "JZ",    true)
    has_operand = map_set(has_operand, "LOAD",  true)
    has_operand = map_set(has_operand, "STORE", true)
    has_operand = map_set(has_operand, "CLS",   true)

    # ── Tokenize ───────────────────────────────────────────────────────────
    let !tokens = list()
    let lines = regex_split("\n", src)
    let !li = 0
    while li < list_len(lines) {
        let line = list_get(lines, li)
        let halves = regex_split("#", line)
        let code_part = list_get(halves, 0)
        let words = regex_find_all("[^\\s]+", code_part)
        let !wi = 0
        while wi < list_len(words) {
            tokens = list_push(tokens, list_get(words, wi))
            wi = wi + 1
        }
        li = li + 1
    }

    # ── Pass 1: collect label positions and named slots ────────────────────
    let !label_map  = map()
    let !slot_map   = map()
    let !next_slot  = 0
    let !byte_pos   = 0
    let !ti = 0
    while ti < list_len(tokens) {
        let tok = list_get(tokens, ti)
        if regex_match(":$", tok) {
            # label definition
            let name = regex_replace(":$", tok, "")
            label_map = map_set(label_map, name, byte_pos)
            ti = ti + 1
        } else {
            if map_has(opcode_map, tok) {
                byte_pos = byte_pos + 1
                if map_has(has_operand, tok) {
                    ti = ti + 1
                    if ti < list_len(tokens) {
                        let operand = list_get(tokens, ti)
                        # register named slots for LOAD/STORE
                        if tok == "LOAD" {
                            if regex_match("^[0-9]+$", operand) == false {
                                if map_has(slot_map, operand) == false {
                                    slot_map = map_set(slot_map, operand, next_slot)
                                    next_slot = next_slot + 1
                                }
                            }
                        }
                        if tok == "STORE" {
                            if regex_match("^[0-9]+$", operand) == false {
                                if map_has(slot_map, operand) == false {
                                    slot_map = map_set(slot_map, operand, next_slot)
                                    next_slot = next_slot + 1
                                }
                            }
                        }
                        byte_pos = byte_pos + 1
                    }
                }
                ti = ti + 1
            } else {
                ti = ti + 1   # unknown token, skip
            }
        }
    }

    # ── Pass 2: emit bytes ─────────────────────────────────────────────────
    let !out = list()
    ti = 0
    while ti < list_len(tokens) {
        let tok = list_get(tokens, ti)
        if regex_match(":$", tok) {
            ti = ti + 1   # label definition: no bytes
        } else {
            if map_has(opcode_map, tok) {
                out = list_push(out, map_get(opcode_map, tok))
                if map_has(has_operand, tok) {
                    ti = ti + 1
                    if ti < list_len(tokens) {
                        let operand = list_get(tokens, ti)
                        if tok == "LOAD" {
                            if regex_match("^[0-9]+$", operand) {
                                out = list_push(out, to_int(operand))
                            } else {
                                out = list_push(out, map_get(slot_map, operand))
                            }
                        } else {
                            if tok == "STORE" {
                                if regex_match("^[0-9]+$", operand) {
                                    out = list_push(out, to_int(operand))
                                } else {
                                    out = list_push(out, map_get(slot_map, operand))
                                }
                            } else {
                                # JMP / JZ → label or literal; PUSH / CLS → literal
                                if regex_match("^[0-9]+$", operand) {
                                    out = list_push(out, to_int(operand))
                                } else {
                                    if map_has(label_map, operand) {
                                        out = list_push(out, map_get(label_map, operand))
                                    } else {
                                        out = list_push(out, 0)
                                    }
                                }
                            }
                        }
                    }
                }
                ti = ti + 1
            } else {
                ti = ti + 1   # unknown, skip
            }
        }
    }

    out
}

pub fn asm_size(bytes: list) -> i64 {
    list_len(bytes)
}

pub fn asm_dump(bytes: list) -> nil {
    let n = list_len(bytes)
    print(format("cart: {} bytes", n))
    let !row = "[ "
    let !i = 0
    while i < n {
        row = row + format("{}u8", list_get(bytes, i))
        if i < n - 1 { row = row + ", " }
        i = i + 1
    }
    row = row + " ]"
    print(row)
    nil
}

# ── Tests ─────────────────────────────────────────────────────────────────────

# HALT has opcode 0 and takes no operand → exactly 1 byte: [0]
fn test_halt_single_byte() -> bool {
    let bytes = asm_compile("HALT")
    asm_size(bytes) == 1 && list_get(bytes, 0) == 0
}

# PUSH has opcode 1 and takes one operand byte → 2 bytes: [1, 42]
fn test_push_literal() -> bool {
    let bytes = asm_compile("PUSH 42")
    asm_size(bytes) == 2 && list_get(bytes, 0) == 1 && list_get(bytes, 1) == 42
}

# PUSH 3, PUSH 5, ADD → 5 bytes: [1,3,1,5,2]
# ADD opcode=2 has no operand
fn test_add_sequence() -> bool {
    let bytes = asm_compile("PUSH 3\nPUSH 5\nADD")
    asm_size(bytes) == 5 &&
    list_get(bytes, 0) == 1 && list_get(bytes, 1) == 3 &&
    list_get(bytes, 2) == 1 && list_get(bytes, 3) == 5 &&
    list_get(bytes, 4) == 2
}

# Comments (text after '#') are stripped before assembly.
# "PUSH 1 # a comment\nADD" → same as "PUSH 1\nADD" → [1, 1, 2]
fn test_comment_stripped() -> bool {
    let bytes = asm_compile("PUSH 1 # a comment\nADD")
    asm_size(bytes) == 3 &&
    list_get(bytes, 0) == 1 &&
    list_get(bytes, 1) == 1 &&
    list_get(bytes, 2) == 2
}

# Label resolution: 'loop:' at byte_pos 2 (after PUSH 10 which emits 2 bytes).
# JMP loop → opcode=9, operand=2. Bytes: [1,10,1,1,9,2]
fn test_label_resolution() -> bool {
    let src = "PUSH 10\nloop:\nPUSH 1\nJMP loop"
    let bytes = asm_compile(src)
    asm_size(bytes) == 6 &&
    list_get(bytes, 0) == 1  && list_get(bytes, 1) == 10 &&
    list_get(bytes, 2) == 1  && list_get(bytes, 3) == 1  &&
    list_get(bytes, 4) == 9  && list_get(bytes, 5) == 2
}

# Named slot auto-assignment: first named slot gets index 0.
# PUSH 5 → [1,5]; STORE x → opcode=12, slot 0; LOAD x → opcode=11, slot 0
# Bytes: [1, 5, 12, 0, 11, 0]
fn test_named_slot() -> bool {
    let src = "PUSH 5\nSTORE x\nLOAD x"
    let bytes = asm_compile(src)
    asm_size(bytes) == 6 &&
    list_get(bytes, 0) == 1  && list_get(bytes, 1) == 5  &&
    list_get(bytes, 2) == 12 && list_get(bytes, 3) == 0  &&
    list_get(bytes, 4) == 11 && list_get(bytes, 5) == 0
}

# Two distinct named slots get consecutive indices 0 and 1.
# STORE a → slot 0; STORE b → slot 1; LOAD a → slot 0; LOAD b → slot 1
fn test_two_named_slots() -> bool {
    let src = "PUSH 1\nSTORE a\nPUSH 2\nSTORE b\nLOAD a\nLOAD b"
    let bytes = asm_compile(src)
    # PUSH 1 [1,1], STORE a [12,0], PUSH 2 [1,2], STORE b [12,1], LOAD a [11,0], LOAD b [11,1]
    # 12 bytes total
    asm_size(bytes) == 12 &&
    list_get(bytes, 3)  == 0 &&   # STORE a → slot 0
    list_get(bytes, 7)  == 1 &&   # STORE b → slot 1
    list_get(bytes, 9)  == 0 &&   # LOAD a  → slot 0
    list_get(bytes, 11) == 1       # LOAD b  → slot 1
}

# asm_size wraps list_len — verify it equals byte count for a known program
fn test_asm_size_matches_byte_count() -> bool {
    let bytes = asm_compile("PUSH 7\nPUSH 3\nSUB\nHALT")
    # PUSH 7 → 2, PUSH 3 → 2, SUB → 1, HALT → 1 = 6
    asm_size(bytes) == 6
}

fn main() -> nil {
    let path = if cli_positional_count() > 0 { cli_positional(0) } else { "examples/console/snake.asm" }
    let (src, _) = read_file(path)
    let bytes = asm_compile(src)
    asm_dump(bytes)
    print(format("assembled {} bytes", asm_size(bytes)))
    nil
}
