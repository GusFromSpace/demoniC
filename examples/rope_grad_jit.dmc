# rope forward + reverse-mode VJP under the JIT.
#
# RoPE (rotary position embedding) is the position encoding in modern LLMs
# (Qwen, Llama, …), and the fourth fused tensor op to differentiate under the
# JIT @grad subset — after softmax, rms_norm, and layer_norm.
#
# RoPE rotates each coordinate pair (x_even, x_odd) at sequence position s by
# the table angle (cos[s,i], sin[s,i]):
#   y_even = x_even·cos − x_odd·sin
#   y_odd  = x_odd·cos  + x_even·sin
# That is an orthogonal rotation, so its backward is the INVERSE (transpose)
# rotation applied to the incoming adjoint — the same kernel with sin negated:
#   dx = rope(g, cos, −sin)
# The gradient flows ONLY to x; cos/sin are read-only position tables.
#
# These RUN and match the interpreter under `dmc test --jit`. Bracketed values
# were cross-checked interp-vs-JIT (both agree to f32); the interpreter VJP is
# itself finite-diff-validated in gradcheck.dmc. Second-order falls back to interp.

# ── forward parity: 90° rotation (cos=0, sin=1) maps (x0,x1) → (−x1, x0) ──────
fn test_rope_forward() -> bool {
    let !x = forge.zeros[f32, [1, 1, 2, 4]]
    # row 0: [3, 4, 1, 2] ; row 1: [5, 6, 7, 8]
    x[0,0,0,0]=3.0  x[0,0,0,1]=4.0  x[0,0,0,2]=1.0  x[0,0,0,3]=2.0
    x[0,0,1,0]=5.0  x[0,0,1,1]=6.0  x[0,0,1,2]=7.0  x[0,0,1,3]=8.0
    let !c = forge.zeros[f32, [2, 2]]      # cos = 0 everywhere
    let !s = forge.zeros[f32, [2, 2]]      # sin = 1 everywhere → 90° rotation
    s[0,0]=1.0  s[0,1]=1.0  s[1,0]=1.0  s[1,1]=1.0
    let y = rope(x, c, s)
    # pair (a,b) → (−b, a):  row0 → [−4, 3, −2, 1] ; row1 → [−6, 5, −8, 7]
    (y[0,0,0,0] < 0.0-3.99) && (y[0,0,0,0] > 0.0-4.01) && (y[0,0,0,1] > 2.99) && (y[0,0,0,1] < 3.01)
        && (y[0,0,0,2] < 0.0-1.99) && (y[0,0,0,3] > 0.99)
        && (y[0,0,1,0] < 0.0-5.99) && (y[0,0,1,1] > 4.99) && (y[0,0,1,3] > 6.99)
}

# ── VJP to x: loss = sum(rope(x, c, s)^2) with arbitrary (non-unit) tables ────
# Non-unit-circle cos/sin exercise the transpose Jacobian rather than relying
# on the norm-preserving property of a true rotation.
@grad fn rp_loss(!x: Tensor[f32, [1, 1, 2, 4]], c: Tensor[f32, [2, 2]], s: Tensor[f32, [2, 2]]) -> f32 {
    let y = rope(x, c, s)
    sum(y .* y)
}

fn test_rope_grad() -> bool {
    let !x = forge.zeros[f32, [1, 1, 2, 4]]
    x[0,0,0,0]=1.0  x[0,0,0,1]=2.0  x[0,0,0,2]=0.5  x[0,0,0,3]=0.0-1.0
    x[0,0,1,0]=0.3  x[0,0,1,1]=0.0-0.7  x[0,0,1,2]=1.5  x[0,0,1,3]=2.0
    let !c = forge.zeros[f32, [2, 2]]
    c[0,0]=0.6  c[0,1]=0.8  c[1,0]=0.2  c[1,1]=0.9
    let !s = forge.zeros[f32, [2, 2]]
    s[0,0]=0.8  s[0,1]=0.6  s[1,0]=0.9  s[1,1]=0.3
    let (l, gr) = rp_loss.fwd_bwd(x, c, s)
    # verified (interp == JIT): l≈12.368 ; dx[0,0,1,2]≈2.700 ; dx[0,0,1,3]≈3.600
    (l > 12.36) && (l < 12.38)
        && (gr.x[0,0,1,2] > 2.69) && (gr.x[0,0,1,2] < 2.71)
        && (gr.x[0,0,1,3] > 3.59) && (gr.x[0,0,1,3] < 3.61)
}
