# relu.dmc — operator fusion via `\|>`.
# The chain below compiles to ONE SIMD loop over the data. No
# intermediate Forge allocation between stages.

fn mlp[B, D, H](
    x: Tensor[f32, [B, D]],
    w1: Tensor[f32, [D, H]],
    b1: Tensor[f32, [H]],
    w2: Tensor[f32, [H, D]],
    b2: Tensor[f32, [D]],
) -> Tensor[f32, [B, D]] {
    # Read this top to bottom:
    #   x @ w1            → [B, H]
    #   .+ b1             → broadcast bias across batch
    #   \>                → ReLU, fused
    #   @ w2              → [B, D]
    #   .+ b2             → broadcast output bias
    x @ w1
        \|> _ .+ b1
        \|> \>
        \|> _ @ w2
        \|> _ .+ b2
}

# `_` inside a pipe stage is the implicit pipe value. It is the only
# place `_` is legal in expression position.

# ── tests ────────────────────────────────────────────────────────────────────

# All-zero weights and biases → all-zero output regardless of input.
# Hand derivation: x@0 = 0; 0.+0=0; relu(0)=0; 0@0=0; 0.+0=0.
fn test_zero_weights_zero_output() -> bool {
    let !x  = forge.zeros[f32, [1, 1]]
    let !w1 = forge.zeros[f32, [1, 1]]
    let !b1 = forge.zeros[f32, [1]]
    let !w2 = forge.zeros[f32, [1, 1]]
    let !b2 = forge.zeros[f32, [1]]
    x[0, 0] = 1.0
    let out = mlp[1, 1, 1](x, w1, b1, w2, b2)
    let result = isclose(out[0, 0], 0.0)
    forge.reset()
    result
}

# Positive hidden value passes through ReLU unchanged.
# x=[[2]], w1=[[1]], b1=[0], w2=[[1]], b2=[0]
# h = 2*1 = 2; relu(2) = 2; out = 2*1 = 2; out+0 = 2.
fn test_positive_passthrough() -> bool {
    let !x  = forge.zeros[f32, [1, 1]]
    let !w1 = forge.zeros[f32, [1, 1]]
    let !b1 = forge.zeros[f32, [1]]
    let !w2 = forge.zeros[f32, [1, 1]]
    let !b2 = forge.zeros[f32, [1]]
    x[0, 0]  = 2.0
    w1[0, 0] = 1.0
    w2[0, 0] = 1.0
    let out = mlp[1, 1, 1](x, w1, b1, w2, b2)
    let result = isclose(out[0, 0], 2.0)
    forge.reset()
    result
}

# Negative pre-activation is zeroed by ReLU; only output bias survives.
# x=[[-1]], w1=[[1]], b1=[0], w2=[[3]], b2=[5]
# h_pre = -1; relu(-1) = 0; 0*3 = 0; 0+5 = 5.
fn test_relu_kills_negative() -> bool {
    let !x  = forge.zeros[f32, [1, 1]]
    let !w1 = forge.zeros[f32, [1, 1]]
    let !b1 = forge.zeros[f32, [1]]
    let !w2 = forge.zeros[f32, [1, 1]]
    let !b2 = forge.zeros[f32, [1]]
    x[0, 0]  = -1.0
    w1[0, 0] =  1.0
    w2[0, 0] =  3.0
    b2[0]    =  5.0
    let out = mlp[1, 1, 1](x, w1, b1, w2, b2)
    let result = isclose(out[0, 0], 5.0)
    forge.reset()
    result
}

# Output bias is added even when the hidden layer is all-zero.
# x=[[0]], w1=[[7]], b1=[0], w2=[[9]], b2=[3]
# h = 0; relu(0) = 0; 0*9 = 0; 0+3 = 3.
fn test_output_bias_propagates() -> bool {
    let !x  = forge.zeros[f32, [1, 1]]
    let !w1 = forge.zeros[f32, [1, 1]]
    let !b1 = forge.zeros[f32, [1]]
    let !w2 = forge.zeros[f32, [1, 1]]
    let !b2 = forge.zeros[f32, [1]]
    w1[0, 0] = 7.0
    w2[0, 0] = 9.0
    b2[0]    = 3.0
    let out = mlp[1, 1, 1](x, w1, b1, w2, b2)
    let result = isclose(out[0, 0], 3.0)
    forge.reset()
    result
}

# Two-hidden-unit case: ReLU selectively zeroes one unit.
# B=1, D=1, H=2
# x=[[1]], w1=[[1,-2]] (1x2), b1=[0,0]
# w2=[[1],[1]] (2x1), b2=[0]
# h_pre = [[1,-2]]; relu = [[1,0]]; out = 1*1 + 0*1 = 1.
fn test_two_hidden_relu_select() -> bool {
    let !x  = forge.zeros[f32, [1, 1]]
    let !w1 = forge.zeros[f32, [1, 2]]
    let !b1 = forge.zeros[f32, [2]]
    let !w2 = forge.zeros[f32, [2, 1]]
    let !b2 = forge.zeros[f32, [1]]
    x[0, 0]  =  1.0
    w1[0, 0] =  1.0
    w1[0, 1] = -2.0
    w2[0, 0] =  1.0
    w2[1, 0] =  1.0
    let out = mlp[1, 1, 2](x, w1, b1, w2, b2)
    let result = isclose(out[0, 0], 1.0)
    forge.reset()
    result
}
