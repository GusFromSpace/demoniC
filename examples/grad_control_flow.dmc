# Differentiable control flow in @grad bodies.
#
# The interpreter's reverse-mode tape runs the forward pass concretely, so a
# data-dependent branch is differentiable by define-by-run: the condition (or
# match scrutinee) is non-differentiable — evaluated for real — and only the
# *taken* branch is recorded onto the tape. The gradient flows through the
# executed path exactly as in eager frameworks; the untaken branch contributes
# nothing. Branches are over whole-tensor computations (the tape differentiates
# tensor ops, not scalar element reads).
#
# Interpreter (`dmc run` / `dmc test`) semantics. The JIT autodiff does not yet
# trace control flow, so these tests are SKIPPED under `dmc test --jit` rather
# than diverging (JIT parity is a tracked follow-up on).

# ── if / else over tensor branches ──────────────────────────────────────────
@grad fn cf[D](!w: Tensor[f32, [D]]) -> f32 {
    let s = sum(w)                                  # scalar derived from the tensor
    let y = if s > 100.0f32 { w } else { w .* w }   # branch picks a tensor computation
    sum(y)
}

fn test_cf_else_branch() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 1.0   w[1] = 2.0
    let (l, g) = cf.fwd_bwd(w)
    # sum(w)=3 <= 100 → else: sum(w.*w) = 1+4 = 5 ; grad = 2w = [2, 4]
    (l == 5.0) && (g.w[0] == 2.0) && (g.w[1] == 4.0)
}

fn test_cf_then_branch() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 60.0   w[1] = 60.0
    let (l, g) = cf.fwd_bwd(w)
    # sum(w)=120 > 100 → then: sum(w) = 120 ; grad = ones = [1, 1]
    (l == 120.0) && (g.w[0] == 1.0) && (g.w[1] == 1.0)
}

# ── else-if chain (piecewise) ───────────────────────────────────────────────
@grad fn cf_chain[D](!w: Tensor[f32, [D]]) -> f32 {
    let s = sum(w)
    let y = if s > 100.0f32 { w .* w } else if s > 0.0f32 { w .+ w } else { w }
    sum(y)
}

fn test_cf_else_if() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 1.0   w[1] = 2.0
    let (l, g) = cf_chain.fwd_bwd(w)
    # sum(w)=3 : not >100, but >0 → middle: sum(w .+ w) = sum(2w) = 6 ; grad = 2·ones = [2, 2]
    (l == 6.0) && (g.w[0] == 2.0) && (g.w[1] == 2.0)
}

# ── match on a scalar selector choosing tensor branches ─────────────────────
@grad fn cf_match[D](!w: Tensor[f32, [D]], mode: i64) -> f32 {
    let y = match mode { 0 => w .* w, 1 => w .+ w, _ => w }
    sum(y)
}

fn test_cf_match() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 3.0   w[1] = 4.0
    let (l0, g0) = cf_match.fwd_bwd(w, 0)   # w.*w → sum 25, grad 2w = [6, 8]
    let (l1, g1) = cf_match.fwd_bwd(w, 1)   # w.+w = 2w → sum 14, grad 2·ones = [2, 2]
    (l0 == 25.0) && (g0.w[0] == 6.0) && (g0.w[1] == 8.0)
        && (l1 == 14.0) && (g1.w[0] == 2.0) && (g1.w[1] == 2.0)
}

# ── loops unroll onto the tape (fixed trip count from concrete execution) ────
# The loop runs for real; each iteration appends its ops and reassignment
# threads the accumulator's tape node, so the gradient chains through all
# iterations. break / continue / return and the unbounded `loop` are not wired.

@grad fn loop_while[D](!w: Tensor[f32, [D]]) -> f32 {
    let !acc = 0.0f32
    let !i = 0
    while i < 3 {
        acc += sum(w .* w)
        i = i + 1
    }
    acc
}

fn test_loop_while() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 1.0   w[1] = 2.0
    let (l, g) = loop_while.fwd_bwd(w)
    # sum(w.*w)=5, ×3 = 15 ; grad = 3·2w = 6w = [6, 12]
    (l == 15.0) && (g.w[0] == 6.0) && (g.w[1] == 12.0)
}

@grad fn loop_for[D](!w: Tensor[f32, [D]]) -> f32 {
    let !acc = 0.0f32
    for k in 0..3 {
        acc += sum(w)
    }
    acc
}

fn test_loop_for() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 3.0   w[1] = 4.0
    let (l, g) = loop_for.fwd_bwd(w)
    # sum(w)=7, ×3 = 21 ; grad = 3·ones = [3, 3]
    (l == 21.0) && (g.w[0] == 3.0) && (g.w[1] == 3.0)
}

# tensor accumulator threaded through iterations: acc = 2w
@grad fn loop_tensor[D](!w: Tensor[f32, [D]]) -> f32 {
    let !acc = forge.zeros[f32, [D]]
    let !i = 0
    while i < 2 {
        acc = acc .+ w
        i = i + 1
    }
    sum(acc)
}

fn test_loop_tensor_acc() -> bool {
    let !w = forge.zeros[f32, [2]]
    w[0] = 5.0   w[1] = 6.0
    let (l, g) = loop_tensor.fwd_bwd(w)
    # acc = 2w = [10, 12], sum = 22 ; grad = 2·ones = [2, 2]
    (l == 22.0) && (g.w[0] == 2.0) && (g.w[1] == 2.0)
}
