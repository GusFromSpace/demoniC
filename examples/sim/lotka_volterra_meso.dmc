# Lotka-Volterra field simulation — THREE-tier food chain.
#
# Adds a mesopredator between the prey and the apex predator:
#   R(x,y,t) = rabbit       density  (basal prey)
#   M(x,y,t) = mesopredator density  (eats rabbits, eaten by foxes)
#   F(x,y,t) = fox          density  (apex predator, eats mesopredators)
#
# Per-step reaction (forward-Euler), the classic tri-trophic chain R -> M -> F:
#   R += dt * ( a*R - b*R*M )            rabbits grow, eaten by mesopredators
#   M += dt * ( c*R*M - d*M - e*M*F )    meso grows by eating R, decays, eaten by F
#   F += dt * ( g*M*F - k*F )            foxes grow by eating M, starve otherwise
# Plus the same 5-point Laplacian diffusion so all three fields spread.
#
# Ecology to watch for: the apex fox suppresses the mesopredator (top-down
# control). Where foxes are thin, the mesopredator is "released" and grazes the
# rabbits down — mesopredator-release dynamics on a grid.
#
# Initial conditions: rabbits bottom-right, foxes upper-left (as before), and
# the mesopredator seeded in the middle so all three must collide.

# ----- rates -----
fn a_rate() -> f32 { 1.2f32 }   # rabbit growth
fn b_rate() -> f32 { 0.9f32 }   # rabbits eaten per mesopredator
fn c_rate() -> f32 { 0.6f32 }   # mesopredators born per rabbit eaten
fn d_rate() -> f32 { 0.35f32 }  # mesopredator natural decay
fn e_rate() -> f32 { 0.7f32 }   # mesopredators eaten per fox
fn g_rate() -> f32 { 0.45f32 }  # foxes born per mesopredator eaten
fn k_rate() -> f32 { 0.5f32 }   # fox starvation
fn dt_step() -> f32 { 0.08f32 }
fn diffusion() -> f32 { 0.15f32 }

# ----- initial fields -----
fn init_rabbits() -> Tensor[f32, [12, 30]] {
    let mut R: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let cr = 9
    let cc = 23
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            let dr = if i > cr { i - cr } else { cr - i }
            let dc = if j > cc { j - cc } else { cc - j }
            let dist = dr + dc
            if dist < 8 {
                R[i, j] = (8 - dist) as f32 * 0.15f32
            }
            j = j + 1
        }
        i = i + 1
    }
    R
}

fn init_meso() -> Tensor[f32, [12, 30]] {
    let mut M: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let cr = 6
    let cc = 15
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            let dr = if i > cr { i - cr } else { cr - i }
            let dc = if j > cc { j - cc } else { cc - j }
            let dist = dr + dc
            if dist < 5 {
                M[i, j] = (5 - dist) as f32 * 0.16f32
            }
            j = j + 1
        }
        i = i + 1
    }
    M
}

fn init_foxes() -> Tensor[f32, [12, 30]] {
    let mut F: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let cr = 2
    let cc = 6
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            let dr = if i > cr { i - cr } else { cr - i }
            let dc = if j > cc { j - cc } else { cc - j }
            let dist = dr + dc
            if dist < 6 {
                F[i, j] = (6 - dist) as f32 * 0.18f32
            }
            j = j + 1
        }
        i = i + 1
    }
    F
}

# 5-point Laplacian diffusion, no-flux boundary.
fn diffuse(X: Tensor[f32, [12, 30]]) -> Tensor[f32, [12, 30]] {
    let mut Y: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let k = diffusion()
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            let here = X[i, j]
            let up    = if i > 0  { X[i - 1, j] } else { here }
            let down  = if i < 11 { X[i + 1, j] } else { here }
            let left  = if j > 0  { X[i, j - 1] } else { here }
            let right = if j < 29 { X[i, j + 1] } else { here }
            let neighbor_avg = (up + down + left + right) * 0.25f32
            Y[i, j] = here + k * (neighbor_avg - here)
            j = j + 1
        }
        i = i + 1
    }
    Y
}

# One forward-Euler reaction step + diffusion for all three fields.
fn step(
    R: Tensor[f32, [12, 30]], M: Tensor[f32, [12, 30]], F: Tensor[f32, [12, 30]]
) -> (Tensor[f32, [12, 30]], Tensor[f32, [12, 30]], Tensor[f32, [12, 30]]) {
    let a = a_rate()
    let b = b_rate()
    let c = c_rate()
    let d = d_rate()
    let e = e_rate()
    let g = g_rate()
    let k = k_rate()
    let h = dt_step()

    let mut Rn: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let mut Mn: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let mut Fn: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            let r = R[i, j]
            let m = M[i, j]
            let f = F[i, j]
            let rm = r * m
            let mf = m * f
            let dR = a * r - b * rm
            let dM = c * rm - d * m - e * mf
            let dF = g * mf - k * f
            let r_new = r + h * dR
            let m_new = m + h * dM
            let f_new = f + h * dF
            Rn[i, j] = if r_new > 0.0f32 { r_new } else { 0.0f32 }
            Mn[i, j] = if m_new > 0.0f32 { m_new } else { 0.0f32 }
            Fn[i, j] = if f_new > 0.0f32 { f_new } else { 0.0f32 }
            j = j + 1
        }
        i = i + 1
    }

    let R2 = diffuse(Rn)
    let M2 = diffuse(Mn)
    let F2 = diffuse(Fn)
    (R2, M2, F2)
}

# Render a cell as the dominant species at one of two density levels.
#   O/o rabbits   M/m mesopredators   X/x foxes   '.' empty
fn render_cell(r: f32, m: f32, f: f32) -> i64 {
    let hi = 0.4f32
    let mid = 0.1f32
    if r >= m && r >= f {
        if r > hi { 79 } else if r > mid { 111 } else { 46 }
    } else if m >= f {
        if m > hi { 77 } else if m > mid { 109 } else { 46 }
    } else {
        if f > hi { 88 } else if f > mid { 120 } else { 46 }
    }
}

fn char_for(code: i64) -> str {
    if code == 79 {
        "O"
    } else if code == 111 {
        "o"
    } else if code == 77 {
        "M"
    } else if code == 109 {
        "m"
    } else if code == 88 {
        "X"
    } else if code == 120 {
        "x"
    } else {
        "."
    }
}

fn print_frame(
    R: Tensor[f32, [12, 30]], M: Tensor[f32, [12, 30]], F: Tensor[f32, [12, 30]], step_num: i64
) -> nil {
    print("step " + to_str(step_num) + ":")
    let mut i = 0
    while i < 12 {
        let mut row = ""
        let mut j = 0
        while j < 30 {
            row = row + char_for(render_cell(R[i, j], M[i, j], F[i, j]))
            j = j + 1
        }
        print(row)
        i = i + 1
    }
    print("")
    nil
}

fn total(X: Tensor[f32, [12, 30]]) -> f32 {
    let mut s = 0.0f32
    let mut i = 0
    while i < 12 {
        let mut j = 0
        while j < 30 {
            s = s + X[i, j]
            j = j + 1
        }
        i = i + 1
    }
    s
}

# ---- tests ----

# Rabbit center cell (9,23): dist=0 → (8-0)*0.15 = 1.2
fn test_rabbit_center() -> bool {
    let R = init_rabbits()
    let v = R[9, 23]
    v > 1.1999f32 && v < 1.2001f32
}

# Rabbit adjacent cell (9,22): dist=1 → (8-1)*0.15 = 1.05
fn test_rabbit_adjacent() -> bool {
    let R = init_rabbits()
    let v = R[9, 22]
    v > 1.0499f32 && v < 1.0501f32
}

# Meso center cell (6,15): dist=0 → (5-0)*0.16 = 0.80
fn test_meso_center() -> bool {
    let M = init_meso()
    let v = M[6, 15]
    v > 0.7999f32 && v < 0.8001f32
}

# Fox center cell (2,6): dist=0 → (6-0)*0.18 = 1.08
fn test_fox_center() -> bool {
    let F = init_foxes()
    let v = F[2, 6]
    v > 1.0799f32 && v < 1.0801f32
}

# Corners are far from all seeds: cell (0,0) is dist=32 from rabbit seed,
# dist=21 from meso seed, dist=8 from fox seed (all >= thresholds), so all zero.
fn test_far_corner_zero() -> bool {
    let R = init_rabbits()
    let M = init_meso()
    let F = init_foxes()
    R[0, 0] == 0.0f32 && M[0, 0] == 0.0f32 && F[0, 0] == 0.0f32
}

# render_cell: r=0.5 dominant, r > hi(0.4) → 79 (ASCII 'O')
fn test_render_cell_rabbit_hi() -> bool {
    render_cell(0.5f32, 0.0f32, 0.0f32) == 79
}

# render_cell: r=0.2, m=0, f=0 → r dominant, r > mid(0.1) but not > hi → 111 ('o')
fn test_render_cell_rabbit_mid() -> bool {
    render_cell(0.2f32, 0.0f32, 0.0f32) == 111
}

# render_cell: r=0, m=0, f=0.5 → fox dominant, f > hi(0.4) → 88 ('X')
fn test_render_cell_fox_hi() -> bool {
    render_cell(0.0f32, 0.0f32, 0.5f32) == 88
}

# render_cell: r=0, m=0.5, f=0 → meso dominant, m > hi(0.4) → 77 ('M')
fn test_render_cell_meso_hi() -> bool {
    render_cell(0.0f32, 0.5f32, 0.0f32) == 77
}

# render_cell: all zero → '.' (46)
fn test_render_cell_empty() -> bool {
    render_cell(0.0f32, 0.0f32, 0.0f32) == 46
}

# Diffuse conserves total mass (no-flux Neumann BC): each cell becomes a convex
# combination of its own value and neighbor average, so total sum is invariant.
fn test_diffuse_conserves_mass() -> bool {
    let R = init_rabbits()
    let before = total(R)
    let R2 = diffuse(R)
    let after = total(R2)
    let diff = if before > after { before - after } else { after - before }
    diff < 0.001f32
}

# step() with all-zero fields leaves all fields zero.
fn test_step_zero_fields_stay_zero() -> bool {
    let Z: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let (R2, M2, F2) = step(Z, Z, Z)
    total(R2) == 0.0f32 && total(M2) == 0.0f32 && total(F2) == 0.0f32
}

# With only rabbits (M=0, F=0), each cell's rabbit count grows by factor (1+dt*a)
# before diffusion. dt=0.08, a=1.2 → factor=1.096. After diffuse the total should
# equal original_total * 1.096 (diffuse conserves mass). Tolerance 1e-3.
fn test_step_rabbits_only_growth() -> bool {
    let R = init_rabbits()
    let Z: Tensor[f32, [12, 30]] = forge.zeros[f32, [12, 30]]
    let r0 = total(R)
    let (R2, M2, F2) = step(R, Z, Z)
    let r1 = total(R2)
    # expected factor: 1 + dt*a = 1 + 0.08*1.2 = 1.096
    let expected = r0 * 1.096f32
    let diff = if r1 > expected { r1 - expected } else { expected - r1 }
    diff < 0.01f32
}

fn main() -> nil {
    print("--- three-tier food chain (rabbits -> mesopredator -> foxes), 12x30, 64 steps ---")
    print("legend: '.' empty   o/O rabbits   m/M mesopredators   x/X foxes")
    print("")

    let mut R = init_rabbits()
    let mut M = init_meso()
    let mut F = init_foxes()

    print_frame(R, M, F, 0)
    print("totals: rabbits=" + to_str(total(R)) + "  meso=" + to_str(total(M)) + "  foxes=" + to_str(total(F)))
    print("")

    let mut s = 1
    while s <= 64 {
        let (R2, M2, F2) = step(R, M, F)
        R = R2
        M = M2
        F = F2
        if s % 8 == 0 {
            print_frame(R, M, F, s)
            print("totals: rabbits=" + to_str(total(R)) + "  meso=" + to_str(total(M)) + "  foxes=" + to_str(total(F)))
            print("")
        }
        s = s + 1
    }

    nil
}
