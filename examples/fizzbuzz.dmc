# fizzbuzz.dmc — Classic FizzBuzz 1–30.
# Demonstrates: for loop, modulo operator, if/else if/else, string print.
# No JIT needed. Run: dmc run examples/fizzbuzz.dmc

# --- numeric gate: FizzBuzz classification is independently known ---
# fizzbuzz_code restates main's branch order: 3=FizzBuzz, 1=Fizz, 2=Buzz, 0=number.
fn fizzbuzz_code(i: i64) -> i64 {
    if i % 15 == 0 {
        3
    } else if i % 3 == 0 {
        1
    } else if i % 5 == 0 {
        2
    } else {
        0
    }
}

# 1->number, 3->Fizz, 5->Buzz, 15->FizzBuzz, 30->FizzBuzz, 9->Fizz, 10->Buzz.
fn test_fizzbuzz_codes() -> bool {
    fizzbuzz_code(1) == 0 && fizzbuzz_code(3) == 1 && fizzbuzz_code(5) == 2 &&
        fizzbuzz_code(15) == 3 && fizzbuzz_code(30) == 3 &&
        fizzbuzz_code(9) == 1 && fizzbuzz_code(10) == 2
}

# Over 1..30 there are exactly 2 FizzBuzz (15,30), 8 Fizz, 4 Buzz.
# Multiples of 3: 10; of 5: 6; of 15: 2. Fizz-only = 10-2 = 8, Buzz-only = 6-2 = 4.
fn test_fizzbuzz_counts() -> bool {
    let !fizz = 0
    let !buzz = 0
    let !fizzbuzz = 0
    for i in 1..31 {
        let c = fizzbuzz_code(i)
        if c == 1 { fizz = fizz + 1 }
        if c == 2 { buzz = buzz + 1 }
        if c == 3 { fizzbuzz = fizzbuzz + 1 }
    }
    fizz == 8 && buzz == 4 && fizzbuzz == 2
}

fn main() -> nil {
    for i in 1..31 {
        if i % 15 == 0 {
            print("FizzBuzz")
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(i)
        }
    }
    nil
}
