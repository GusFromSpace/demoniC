# m0_jit.dmc — JIT-runnable slice of the M0 SDF raymarcher.
#
# Identical compute to m0_sphere.dmc (march + finite-difference normals +
# Lambert shading) but returns an integer-exact checksum — the sphere's
# pixel count, `sum(hitmask)` — instead of writing a PPM. The string-based
# PPM serialization is the one part the JIT does not lower (strings / file
# I/O are not compute), so this variant runs under BOTH backends:
#
#   dmc jit examples/render/m0_jit.dmc   ->  => 3176   (native Cranelift)
#   dmc run examples/render/m0_jit.dmc   ->  => 3176   (interpreter)
#
# The bit-exact agreement demonstrates the whole renderer compute surface
# — forge.zeros, reshape, axis-broadcast, `.^`, `\>`, comparison masks,
# while-loop tensor accumulators, generic-call shape inference — running
# through the JIT.

# Signed distance to a sphere, evaluated for every pixel at once.
# The whole renderer queries the scene only through functions like this.
fn sdf_sphere[H, W](
    px: Tensor[f32,[H,W]], py: Tensor[f32,[H,W]], pz: Tensor[f32,[H,W]],
    cx: f32, cy: f32, cz: f32, r: f32
) -> Tensor[f32,[H,W]] {
    let dx = px .- cx
    let dy = py .- cy
    let dz = pz .- cz
    (dx .* dx .+ dy .* dy .+ dz .* dz) .^ 0.5 .- r
}

fn main() -> i64 {
    let H = 120
    let W = 160

    # Scene: one sphere.
    let scx = 0.0
    let scy = 0.0
    let scz = -3.0
    let rad = 1.0

    # ── 1. Ray generation (pinhole camera at origin, looking down -z) ──
    # Vertical coords 1.0..-1.0, horizontal -aspect..aspect.
    let !ys = forge.zeros[f32, [120]]
    let !ri = 0
    while ri < H { ys[ri] = 1.0 - (ri as f32) * (2.0 / 119.0); ri = ri + 1 }
    let !xs = forge.zeros[f32, [160]]
    let !ci = 0
    while ci < W { xs[ci] = -1.333 + (ci as f32) * (2.666 / 159.0); ci = ci + 1 }

    let ys2 = ys.reshape[[120, 1]]   # broadcasts down columns
    let xs2 = xs.reshape[[1, 160]]   # broadcasts across rows

    # Ray directions, normalized. Camera origin is (0,0,0).
    let rx = xs2
    let ry = ys2
    let rz = -1.5
    let rl = (rx .* rx .+ ry .* ry .+ 2.25) .^ 0.5
    let dx = rx ./ rl
    let dy = ry ./ rl
    let dz = rz ./ rl

    # ── 2. Sphere-trace march ─────────────────────────────────────────
    # Accumulators allocated before the loop so they survive each step.
    let !t    = forge.zeros[f32, [120, 160]]
    let !done = forge.zeros[f32, [120, 160]]

    let !k = 0
    while k < 64 {
        let px = t .* dx
        let py = t .* dy
        let pz = t .* dz
        let d  = sdf_sphere[120, 160](px, py, pz, scx, scy, scz, rad)
        let absd = (d .* d) .^ 0.5            # |d|, lane-wise
        let hit  = absd .< 0.005              # converged onto a surface
        let miss = t .> 12.0                  # escaped to infinity
        done = (done .+ hit .+ miss) .> 0.5   # collapse to a 0/1 mask
        t = t .+ d .* (1.0 .- done)           # frozen rays stop advancing
        k = k + 1
    }

    # Final hit point and hit mask.
    let px = t .* dx
    let py = t .* dy
    let pz = t .* dz
    let dfin    = sdf_sphere[120, 160](px, py, pz, scx, scy, scz, rad)
    let escaped = t .> 12.0
    let hitmask = 1.0 .- escaped              # 1 where a surface was reached

    # ── 3. Normals from the SDF gradient via central differences (§5) ──
    let e = 0.0015
    let sx1 = sdf_sphere[120,160](px .+ e, py, pz, scx,scy,scz,rad)
    let sx0 = sdf_sphere[120,160](px .- e, py, pz, scx,scy,scz,rad)
    let sy1 = sdf_sphere[120,160](px, py .+ e, pz, scx,scy,scz,rad)
    let sy0 = sdf_sphere[120,160](px, py .- e, pz, scx,scy,scz,rad)
    let sz1 = sdf_sphere[120,160](px, py, pz .+ e, scx,scy,scz,rad)
    let sz0 = sdf_sphere[120,160](px, py, pz .- e, scx,scy,scz,rad)
    let nx = sx1 .- sx0
    let ny = sy1 .- sy0
    let nz = sz1 .- sz0
    let nl = (nx .* nx .+ ny .* ny .+ nz .* nz) .^ 0.5 .+ 0.000001
    let Nx = nx ./ nl
    let Ny = ny ./ nl
    let Nz = nz ./ nl

    # ── 4. Shading: one directional light, Lambert diffuse + ambient ──
    let lx = 0.577
    let ly = 0.577
    let lz = 0.577
    let diffuse = \>(Nx .* lx .+ Ny .* ly .+ Nz .* lz)   # max(N·L, 0)
    let shade   = 0.15 .+ 0.85 .* diffuse                # ambient + diffuse

    # Albedo (warm orange sphere) over a vertical sky gradient background.
    let !rf = forge.zeros[f32, [120]]
    let !rj = 0
    while rj < H { rf[rj] = (rj as f32) / 119.0; rj = rj + 1 }
    let rfc = rf.reshape[[120, 1]]
    let bgR = 0.45 .+ 0.45 .* rfc
    let bgG = 0.62 .+ 0.30 .* rfc
    let bgB = 0.95 .- 0.10 .* rfc

    let R = hitmask .* (0.95 .* shade) .+ (1.0 .- hitmask) .* bgR
    let G = hitmask .* (0.45 .* shade) .+ (1.0 .- hitmask) .* bgG
    let B = hitmask .* (0.30 .* shade) .+ (1.0 .- hitmask) .* bgB

    # integer-exact checksum: sphere pixel count (mask is 0/1).
    sum(hitmask) as i64
}

# ── Tests ─────────────────────────────────────────────────────────────────────

# sdf_sphere at a point exactly on the sphere surface.
# Sphere centred at (0,0,-3) with radius 1.
# Point (0, 0, -2): distance = sqrt((0)^2+(0)^2+(1)^2) - 1 = 1 - 1 = 0.
fn test_sdf_sphere_on_surface() -> bool {
    let !px = forge.zeros[f32, [1, 1]]
    let !py = forge.zeros[f32, [1, 1]]
    let !pz = forge.zeros[f32, [1, 1]]
    px[0, 0] = 0.0
    py[0, 0] = 0.0
    pz[0, 0] = -2.0
    let d = sdf_sphere[1, 1](px, py, pz, 0.0, 0.0, -3.0, 1.0)
    let v = d[0, 0]
    v > -0.001 && v < 0.001
}

# sdf_sphere at a point outside the sphere must be positive.
# Point (0, 0, 0): distance = sqrt(0+0+9) - 1 = 3 - 1 = 2.
fn test_sdf_sphere_outside() -> bool {
    let !px = forge.zeros[f32, [1, 1]]
    let !py = forge.zeros[f32, [1, 1]]
    let !pz = forge.zeros[f32, [1, 1]]
    px[0, 0] = 0.0
    py[0, 0] = 0.0
    pz[0, 0] = 0.0
    let d = sdf_sphere[1, 1](px, py, pz, 0.0, 0.0, -3.0, 1.0)
    let v = d[0, 0]
    # expected: 2.0  (3 - 1)
    v > 1.999 && v < 2.001
}

# sdf_sphere at the sphere centre must equal negative radius.
# Point (0, 0, -3) = centre: distance = sqrt(0) - 1 = -1.
fn test_sdf_sphere_inside() -> bool {
    let !px = forge.zeros[f32, [1, 1]]
    let !py = forge.zeros[f32, [1, 1]]
    let !pz = forge.zeros[f32, [1, 1]]
    px[0, 0] = 0.0
    py[0, 0] = 0.0
    pz[0, 0] = -3.0
    let d = sdf_sphere[1, 1](px, py, pz, 0.0, 0.0, -3.0, 1.0)
    let v = d[0, 0]
    # expected: -1.0
    v > -1.001 && v < -0.999
}

# The hitmask produced by the full renderer must be binary (0 or 1 per pixel).
# Invariant: mask .* (1 - mask) == 0 for all pixels  <=>  sum of that is 0.
fn test_hitmask_is_binary() -> bool {
    let H = 120
    let W = 160
    let scx = 0.0
    let scy = 0.0
    let scz = -3.0
    let rad = 1.0
    let !ys = forge.zeros[f32, [120]]
    let !ri = 0
    while ri < H { ys[ri] = 1.0 - (ri as f32) * (2.0 / 119.0); ri = ri + 1 }
    let !xs = forge.zeros[f32, [160]]
    let !ci = 0
    while ci < W { xs[ci] = -1.333 + (ci as f32) * (2.666 / 159.0); ci = ci + 1 }
    let ys2 = ys.reshape[[120, 1]]
    let xs2 = xs.reshape[[1, 160]]
    let rx = xs2
    let ry = ys2
    let rz = -1.5
    let rl = (rx .* rx .+ ry .* ry .+ 2.25) .^ 0.5
    let dx = rx ./ rl
    let dy = ry ./ rl
    let dz = rz ./ rl
    let !t    = forge.zeros[f32, [120, 160]]
    let !done = forge.zeros[f32, [120, 160]]
    let !k = 0
    while k < 64 {
        let px = t .* dx
        let py = t .* dy
        let pz = t .* dz
        let d  = sdf_sphere[120, 160](px, py, pz, scx, scy, scz, rad)
        let absd = (d .* d) .^ 0.5
        let hit  = absd .< 0.005
        let miss = t .> 12.0
        done = (done .+ hit .+ miss) .> 0.5
        t = t .+ d .* (1.0 .- done)
        k = k + 1
    }
    let escaped = t .> 12.0
    let hitmask = 1.0 .- escaped
    # mask .* (1 - mask) == 0 for every pixel when mask is strictly 0 or 1
    let check = hitmask .* (1.0 .- hitmask)
    let s = sum(check)
    s > -0.001 && s < 0.001
}

# The sphere pixel count must be plausible for the scene geometry.
# Sphere radius 1 at z=-3, camera at origin looking along -z; the sphere is
# clearly visible and covers a modest fraction of the 19200-pixel (120x160) image.
# Any count outside [500, 8000] would indicate a broken renderer.
fn test_hitmask_pixel_count_plausible() -> bool {
    let H = 120
    let W = 160
    let scx = 0.0
    let scy = 0.0
    let scz = -3.0
    let rad = 1.0
    let !ys = forge.zeros[f32, [120]]
    let !ri = 0
    while ri < H { ys[ri] = 1.0 - (ri as f32) * (2.0 / 119.0); ri = ri + 1 }
    let !xs = forge.zeros[f32, [160]]
    let !ci = 0
    while ci < W { xs[ci] = -1.333 + (ci as f32) * (2.666 / 159.0); ci = ci + 1 }
    let ys2 = ys.reshape[[120, 1]]
    let xs2 = xs.reshape[[1, 160]]
    let rx = xs2
    let ry = ys2
    let rz = -1.5
    let rl = (rx .* rx .+ ry .* ry .+ 2.25) .^ 0.5
    let dx = rx ./ rl
    let dy = ry ./ rl
    let dz = rz ./ rl
    let !t    = forge.zeros[f32, [120, 160]]
    let !done = forge.zeros[f32, [120, 160]]
    let !k = 0
    while k < 64 {
        let px = t .* dx
        let py = t .* dy
        let pz = t .* dz
        let d  = sdf_sphere[120, 160](px, py, pz, scx, scy, scz, rad)
        let absd = (d .* d) .^ 0.5
        let hit  = absd .< 0.005
        let miss = t .> 12.0
        done = (done .+ hit .+ miss) .> 0.5
        t = t .+ d .* (1.0 .- done)
        k = k + 1
    }
    let escaped = t .> 12.0
    let hitmask = 1.0 .- escaped
    let cnt = sum(hitmask)
    cnt > 500.0 && cnt < 8000.0
}
