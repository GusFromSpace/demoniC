# softmax forward + reverse-mode VJP under the JIT.
#
# softmax is the first *fused tensor* op to differentiate under the JIT @grad
# subset (previously interpreter-only). The VJP over the last axis is
#   dx = y .* (g - rowsum(g .* y)),   y = softmax(x)
# emitted per row; the forward uses the shared stable per-row softmax. This is
# the attention case (`softmax(scores, -1)`), so it unblocks JIT-speed attention
# gradients.
#
# Concrete rank-2 shapes → the JIT monomorphizes the backward; these RUN and
# match the interpreter under `dmc test --jit`. The gradient brackets below were
# validated against central finite differences (interpreter). Second-order
# (`@grad @grad`) softmax still falls back to the interpreter.

# ── forward: per-row softmax over the last axis ─────────────────────────────
fn test_softmax_2d_forward() -> bool {
    let !s = forge.zeros[f32, [2, 3]]
    s[0,0]=1.0  s[0,1]=2.0  s[0,2]=3.0
    s[1,0]=0.0  s[1,1]=0.0  s[1,2]=0.0
    let y = softmax(s, 1)
    let r0 = y[0,0] + y[0,1] + y[0,2]
    # each row sums to 1; row 2 is uniform (1/3); row 1 increasing
    (r0 > 0.999) && (r0 < 1.001)
        && (y[1,0] > 0.332) && (y[1,0] < 0.334)
        && (y[0,2] > y[0,1]) && (y[0,1] > y[0,0])
}

# ── reverse-mode VJP: loss = sum(softmax(x)^2) ─────────────────────────────
@grad fn sm_loss(!x: Tensor[f32, [2, 2]]) -> f32 {
    let y = softmax(x, 1)
    sum(y .* y)
}

fn test_softmax_grad() -> bool {
    let !x = forge.zeros[f32, [2, 2]]
    x[0,0]=0.5  x[0,1]=1.5  x[1,0]=0.0-1.0  x[1,1]=2.0
    let (l, g) = sm_loss.fwd_bwd(x)
    # analytic grad ≈ [-0.1817, 0.1817, -0.0818, 0.0818] (finite-diff verified);
    # rows sum to ~0 since a row-constant shift leaves softmax unchanged.
    (g.x[0,0] > 0.0-0.183) && (g.x[0,0] < 0.0-0.180)
        && (g.x[0,1] > 0.180) && (g.x[0,1] < 0.183)
        && (g.x[1,0] > 0.0-0.083) && (g.x[1,0] < 0.0-0.080)
        && (g.x[1,1] > 0.080) && (g.x[1,1] < 0.083)
}

# gradient of a row-constant loss is ~0 (softmax is shift-invariant per row)
@grad fn sm_sum(!x: Tensor[f32, [2, 2]]) -> f32 {
    let y = softmax(x, 1)
    sum(y)
}

fn test_softmax_sum_grad_zero() -> bool {
    let !x = forge.zeros[f32, [2, 2]]
    x[0,0]=0.5  x[0,1]=1.5  x[1,0]=3.0  x[1,1]=0.0-2.0
    let (l, g) = sm_sum.fwd_bwd(x)
    # sum(softmax) == rows (constant) → gradient is 0 everywhere
    (g.x[0,0] > 0.0-0.001) && (g.x[0,0] < 0.001)
        && (g.x[1,1] > 0.0-0.001) && (g.x[1,1] < 0.001)
}
