# matmul.dmc — `@`, `'`, broadcasting.
# Exercises the operator catalog and shape inference end-to-end.

fn attention[B, S, D](
    q: Tensor[f32, [B, S, D]],
    k: Tensor[f32, [B, S, D]],
    v: Tensor[f32, [B, S, D]],
) -> Tensor[f32, [B, S, D]] {
    # k' transposes the last two axes of every batch slice → [B, D, S].
    # The matmul reduces D, producing [B, S, S] attention logits.
    let scores = (q @ k') .* (1.0 / sqrt(D as f32))

    # softmax over the last axis is a stdlib function, not an operator,
    # because it requires more than one SIMD instruction.
    let weights = softmax(scores, -1)

    # Final projection: [B, S, S] @ [B, S, D] → [B, S, D].
    weights @ v
}

fn main() -> nil {
    forge {
        # zeros, not uninit: attention() reads its inputs, and reading
        # uninitialized memory is a compile-time error.
        let q = forge.zeros[f32, [8, 512, 64]]
        let k = forge.zeros[f32, [8, 512, 64]]
        let v = forge.zeros[f32, [8, 512, 64]]
        let out = attention(q, k, v)
        print(out.shape)         # → [8, 512, 64]
    }
    nil
}

# ── Tests ────────────────────────────────────────────────────────────────────

fn absf_mm(x: f32) -> f32 {
    if x < 0.0f32 { 0.0f32 - x } else { x }
}

# Invariant: for any Q, K, when V is all-zeros the output is all-zeros.
# Proof: attention(q,k,v) = softmax(q@k' * scale) @ v.
# Any convex combination (softmax weights sum to 1, all non-negative)
# of zero vectors is zero.  sum(out .* out) = 0.
fn test_attention_zero_v_gives_zero() -> bool {
    let q = forge.zeros[f32, [1, 2, 4]]
    let k = forge.zeros[f32, [1, 2, 4]]
    let v = forge.zeros[f32, [1, 2, 4]]
    let out = attention(q, k, v)
    sum(out .* out) < 0.0001f32
}

# Invariant: when S=1 the single-element softmax collapses to weight=1.0,
# so output equals v exactly (single-token passthrough).
# v[0,0,0]=5, v[0,0,1]=3 → out[0,0,0]=5, out[0,0,1]=3.
fn test_attention_single_seq_passthrough() -> bool {
    let q = forge.zeros[f32, [1, 1, 4]]
    let k = forge.zeros[f32, [1, 1, 4]]
    let !v = forge.zeros[f32, [1, 1, 4]]
    v[0, 0, 0] = 5.0f32
    v[0, 0, 1] = 3.0f32
    let out = attention(q, k, v)
    absf_mm(out[0, 0, 0] - 5.0f32) < 0.0001f32 && absf_mm(out[0, 0, 1] - 3.0f32) < 0.0001f32
}

# Direct matmul identity: A @ I = A.
# A = [[2,3],[5,7]], I = [[1,0],[0,1]].
# (A@I)[0,0] = 2*1+3*0 = 2; [0,1] = 2*0+3*1 = 3;
# [1,0] = 5*1+7*0 = 5; [1,1] = 5*0+7*1 = 7.
fn test_matmul_identity_2x2() -> bool {
    let a = [[2.0, 3.0], [5.0, 7.0]]
    let id = [[1.0, 0.0], [0.0, 1.0]]
    let r = a @ id
    absf_mm(r[0, 0] - 2.0f32) < 0.0001f32 &&
    absf_mm(r[0, 1] - 3.0f32) < 0.0001f32 &&
    absf_mm(r[1, 0] - 5.0f32) < 0.0001f32 &&
    absf_mm(r[1, 1] - 7.0f32) < 0.0001f32
}

# Invariant: when Q=K=zeros all attention scores are equal,
# so softmax gives uniform weights 1/S per position.
# With S=2, each weight = 0.5.
# v row 0 = [4,0,0,0], row 1 = [2,0,0,0].
# output[0,0,0] = 0.5*4 + 0.5*2 = 3.0; output[0,0,1..3] = 0.
fn test_attention_uniform_weights_average_v() -> bool {
    let q = forge.zeros[f32, [1, 2, 4]]
    let k = forge.zeros[f32, [1, 2, 4]]
    let !v = forge.zeros[f32, [1, 2, 4]]
    v[0, 0, 0] = 4.0f32
    v[0, 1, 0] = 2.0f32
    let out = attention(q, k, v)
    absf_mm(out[0, 0, 0] - 3.0f32) < 0.001f32
}
