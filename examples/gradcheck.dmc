# Meta-test, mirroring the l2 one below: the captured-binding gradcheck must
# have teeth. Comparing the numeric slope against a deliberately wrong (zero)
# adjoint — which is exactly what `Grads` used to hand back for a capture:
# nothing at all — has to register a mismatch at every element.
fn test_gradcheck_captured_detects_wrong_gradient() -> bool {
    let h = 0.015625f32
    let !detected = true
    for i in 0..3 {
        let base = cap_b[i]
        cap_b[i] = base + h
        let lp = captured_fwd()
        cap_b[i] = base - h
        let lm = captured_fwd()
        cap_b[i] = base
        let numeric = (lp - lm) / (2.0f32 * h)
        if absf(numeric) <= 0.01f32 { detected = false }   # vs wrong grad = 0
    }
    detected
}

# Meta-test: the check must have teeth — comparing the numeric gradient against a
# deliberately wrong (zero) analytic gradient must register a mismatch, so a
# passing gradcheck above is meaningful and not vacuous.
fn test_gradcheck_detects_wrong_gradient() -> bool {
    let w = [1.0f32, 2.0f32, 3.0f32, 4.0f32]
    let x = [0.5f32, 1.0f32, 2.0f32, 0.0f32]
    let h = 0.001f32
    let !detected = false
    for i in 0..4 {
        let !wp = w  wp[i] = w[i] + h
        let !wm = w  wm[i] = w[i] - h
        let numeric = (l2_fwd(wp, x) - l2_fwd(wm, x)) / (2.0f32 * h)
        if absf(numeric) > 0.02f32 { detected = true }   # vs deliberately wrong grad = 0
    }
    detected
}
