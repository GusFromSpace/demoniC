# embed_index_type.dmc — `embed(vocab, ids)` with a proper integer `ids`
# tensor, on both backends.
#
# `--check` used to accept a FLOAT `ids` tensor: the interpreter then
# gathered rows by truncating the float index, while `dmc jit` refused with
# `` `embed`: ids must be an integer tensor ``. That backend split was the
# bug, closed by rejecting a non-integer `ids` at `--check` time. This file
# is the other half: the legitimate call the fix must not touch. STDLIB.md
# §3.6 declares `ids: Tensor[i64, [...B]]`, and the JIT additionally lowers
# an `i32` `ids` tensor — both stay legal and both must gather the same
# rows on `dmc run` and `dmc jit`.
#
# Run:
#   dmc test examples/embed_index_type.dmc
#   dmc test --jit examples/embed_index_type.dmc

# A 4-row, 2-column embedding table with distinct, hand-checkable rows.
fn vocab4x2() -> Tensor[f32, [4, 2]] {
    let !v = forge.zeros[f32, [4, 2]]
    v[0, 0] = 10.0   v[0, 1] = 11.0
    v[1, 0] = 20.0   v[1, 1] = 21.0
    v[2, 0] = 30.0   v[2, 1] = 31.0
    v[3, 0] = 40.0   v[3, 1] = 41.0
    v
}

# `i64` ids — the canonical form STDLIB.md §3.6 declares — gather the exact
# rows named, in order, including a repeat (row 1 twice).
fn test_embed_gathers_rows_by_i64_id() -> bool {
    let vocab = vocab4x2()
    let !ids = forge.zeros[i64, [3]]
    ids[0] = 2
    ids[1] = 0
    ids[2] = 1
    let out = embed(vocab, ids)
    out[0, 0] == 30.0 && out[0, 1] == 31.0 &&
    out[1, 0] == 10.0 && out[1, 1] == 11.0 &&
    out[2, 0] == 20.0 && out[2, 1] == 21.0
}

# `i32` ids — the JIT's second accepted integer width — must gather the same
# rows as the `i64` form above.
fn test_embed_gathers_rows_by_i32_id() -> bool {
    let vocab = vocab4x2()
    let !ids = forge.zeros[i32, [2]]
    ids[0] = 3
    ids[1] = 1
    let out = embed(vocab, ids)
    out[0, 0] == 40.0 && out[0, 1] == 41.0 &&
    out[1, 0] == 20.0 && out[1, 1] == 21.0
}

# The output shape is `ids.shape ++ [D]` per STDLIB.md §3.6 — a 2-D batch of
# ids produces a 3-D output, not a flattened one.
fn test_embed_output_shape_is_ids_shape_plus_d() -> bool {
    let vocab = vocab4x2()
    let !ids = forge.zeros[i64, [2, 2]]
    ids[0, 0] = 0   ids[0, 1] = 1
    ids[1, 0] = 2   ids[1, 1] = 3
    let out = embed(vocab, ids)
    out[0, 0, 0] == 10.0 && out[0, 1, 0] == 20.0 &&
    out[1, 0, 0] == 30.0 && out[1, 1, 0] == 40.0
}

# ─── main ────────────────────────────────────────────────────────────────────

# The differential-parity half of the gate: prints the same three gathers the
# tests above assert, so `dmc run` and `dmc jit` are compared byte-for-byte.
fn main() -> nil {
    let vocab = vocab4x2()

    let !ids64 = forge.zeros[i64, [3]]
    ids64[0] = 2
    ids64[1] = 0
    ids64[2] = 1
    let out64 = embed(vocab, ids64)
    print(out64[0, 0])
    print(out64[0, 1])
    print(out64[1, 0])
    print(out64[1, 1])
    print(out64[2, 0])
    print(out64[2, 1])

    let !ids32 = forge.zeros[i32, [2]]
    ids32[0] = 3
    ids32[1] = 1
    let out32 = embed(vocab, ids32)
    print(out32[0, 0])
    print(out32[0, 1])
    print(out32[1, 0])
    print(out32[1, 1])

    nil
}
