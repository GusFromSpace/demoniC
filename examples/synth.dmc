# synth.dmc -- ecological CLI synth and beat machine.
# Demonstrates: CLI flags, oscillators, drums, sequencing, tensors, variance.
# Run: dmc run examples/synth.dmc -- --mode=grid --variance
#
# The instrument is a predator-prey field. Rabbits are tonal energy, foxes
# are percussion pressure, and conflict zones are accents. Turning variance
# on pulls rabbits toward their global mean, changing the groove's identity
# instead of only changing a knob.

fn fract(x: f64) -> f64 {
    x - floor(x)
}

fn clamp01(x: f64) -> f64 {
    if x < 0.0 {
        0.0
    } else if x > 1.0 {
        1.0
    } else {
        x
    }
}

fn clamp_audio(x: f64) -> f64 {
    if x < -1.0 {
        -1.0
    } else if x > 1.0 {
        1.0
    } else {
        x
    }
}

fn midi_hz(note: i64) -> f64 {
    440.0 * (2.0 ** ((note as f64 - 69.0) / 12.0))
}

fn osc(wave: str, phase: f64) -> f64 {
    let p = fract(phase)
    if wave == "sin" {
        sin(6.283185307179586 * p)
    } else if wave == "square" {
        if p < 0.5 { 1.0 } else { -1.0 }
    } else if wave == "tri" {
        if p < 0.5 { p * 4.0 - 1.0 } else { 3.0 - p * 4.0 }
    } else {
        p * 2.0 - 1.0
    }
}

fn noise(tick: i64) -> f64 {
    let x = (tick * 1103515245 + 12345) % 2147483647
    (x as f64 / 1073741823.5) - 1.0
}

fn note_from_cell(r: f64, f: f64, col: i64) -> i64 {
    let scale = match col % 8 {
        0 => 0,
        1 => 3,
        2 => 5,
        3 => 7,
        4 => 10,
        5 => 12,
        6 => 15,
        _ => 17,
    }
    let lift = floor(clamp01(r) * 12.0) as i64
    let bite = floor(clamp01(f) * 5.0) as i64
    36 + scale + lift - bite
}

fn voice_env(local: i64, span: i64, r: f64, f: f64) -> f64 {
    let pos = local as f64 / span as f64
    let attack = 0.03 + f * 0.04
    let release = 0.72 - r * 0.22
    if pos < attack {
        pos / attack
    } else if pos > release {
        (1.0 - pos) / (1.0 - release)
    } else {
        0.65 + r * 0.25
    }
}

fn kick(local: i64, span: i64, strength: f64, rate: f64) -> f64 {
    let pos = local as f64 / span as f64
    let decay = if pos < 0.18 { 1.0 - pos / 0.18 } else { 0.0 }
    let hz = 48.0 + 86.0 * (1.0 - pos)
    sin(6.283185307179586 * (local as f64 / rate) * hz) * decay * strength
}

fn snare(local: i64, span: i64, strength: f64) -> f64 {
    let pos = local as f64 / span as f64
    let decay = if pos < 0.24 { 1.0 - pos / 0.24 } else { 0.0 }
    noise(local + 991) * decay * strength
}

fn hat(local: i64, span: i64, strength: f64) -> f64 {
    let pos = local as f64 / span as f64
    let decay = if pos < 0.07 { 1.0 - pos / 0.07 } else { 0.0 }
    noise(local * 17 + 17) * decay * strength
}

fn init_rabbits() -> Tensor[f64, [8, 16]] {
    let mut R: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            let dr = if i > 6 { i - 6 } else { 6 - i }
            let dc = if j > 12 { j - 12 } else { 12 - j }
            let dist = dr + dc
            if dist < 7 {
                R[i, j] = (7 - dist) as f64 * 0.12
            }
            j = j + 1
        }
        i = i + 1
    }
    R
}

fn init_foxes() -> Tensor[f64, [8, 16]] {
    let mut F: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            let dr = if i > 1 { i - 1 } else { 1 - i }
            let dc = if j > 3 { j - 3 } else { 3 - j }
            let dist = dr + dc
            if dist < 5 {
                F[i, j] = (5 - dist) as f64 * 0.16
            }
            j = j + 1
        }
        i = i + 1
    }
    F
}

fn total(X: Tensor[f64, [8, 16]]) -> f64 {
    let mut s = 0.0
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            s = s + X[i, j]
            j = j + 1
        }
        i = i + 1
    }
    s
}

fn diffuse(X: Tensor[f64, [8, 16]]) -> Tensor[f64, [8, 16]] {
    let mut Y: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let k = 0.15
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            let here = X[i, j]
            let up = if i > 0 { X[i - 1, j] } else { here }
            let down = if i < 7 { X[i + 1, j] } else { here }
            let left = if j > 0 { X[i, j - 1] } else { here }
            let right = if j < 15 { X[i, j + 1] } else { here }
            let avg = (up + down + left + right) * 0.25
            Y[i, j] = here + k * (avg - here)
            j = j + 1
        }
        i = i + 1
    }
    Y
}

fn variance_pull(R: Tensor[f64, [8, 16]]) -> Tensor[f64, [8, 16]] {
    let mut Y: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let mean_R = total(R) / 128.0
    let k = 0.16
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            let here = R[i, j]
            Y[i, j] = here + k * (mean_R - here)
            j = j + 1
        }
        i = i + 1
    }
    Y
}

fn eco_step(
    R: Tensor[f64, [8, 16]], F: Tensor[f64, [8, 16]], use_variance: bool
) -> (Tensor[f64, [8, 16]], Tensor[f64, [8, 16]]) {
    let mut Rn: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let mut Fn: Tensor[f64, [8, 16]] = forge.zeros[f64, [8, 16]]
    let mut i = 0
    while i < 8 {
        let mut j = 0
        while j < 16 {
            let r = R[i, j]
            let f = F[i, j]
            let rf = r * f
            let r_new = r + 0.08 * (1.20 * r - 0.80 * rf)
            let f_new = f + 0.08 * (0.50 * rf - 0.90 * f)
            Rn[i, j] = if r_new > 0.0 { r_new } else { 0.0 }
            Fn[i, j] = if f_new > 0.0 { f_new } else { 0.0 }
            j = j + 1
        }
        i = i + 1
    }

    let Rd = diffuse(Rn)
    let Fd = diffuse(Fn)
    let Rv = if use_variance { variance_pull(Rd) } else { Rd }
    (Rv, Fd)
}

fn render_cell(r: f64, f: f64) -> i64 {
    if r > 0.36 {
        if f > 0.36 { 64 } else { 79 }
    } else if f > 0.36 {
        88
    } else if r > 0.09 {
        if f > 0.09 { 35 } else { 111 }
    } else if f > 0.09 {
        120
    } else {
        46
    }
}

fn char_for(code: i64) -> str {
    if code == 64 {
        "@"
    } else if code == 79 {
        "O"
    } else if code == 88 {
        "X"
    } else if code == 35 {
        "#"
    } else if code == 111 {
        "o"
    } else if code == 120 {
        "x"
    } else {
        "."
    }
}

fn print_grid(R: Tensor[f64, [8, 16]], F: Tensor[f64, [8, 16]], step: i64) -> nil {
    print("eco step " + to_str(step) + "  rabbits=" + to_str(total(R)) + "  foxes=" + to_str(total(F)))
    let mut i = 0
    while i < 8 {
        let mut row = ""
        let mut j = 0
        while j < 16 {
            row = row + char_for(render_cell(R[i, j], F[i, j]))
            j = j + 1
        }
        print(row)
        i = i + 1
    }
    print("")
    nil
}

fn pad_str(n: i64) -> str {
    let !s = ""
    let !i = 0
    while i < n {
        s = s + " "
        i = i + 1
    }
    s
}

fn print_scope(v: f64) -> nil {
    let width = 64
    let center = width / 2
    let col = floor((v + 1.0) * (width as f64 * 0.5)) as i64
    let clamped = if col < 0 {
        0
    } else if col > width {
        width
    } else {
        col
    }

    let line = if clamped < center {
        pad_str(clamped) + "*" + pad_str(center - clamped - 1) + "|"
    } else if clamped == center {
        pad_str(center) + "*"
    } else {
        pad_str(center) + "|" + pad_str(clamped - center - 1) + "*"
    }
    print(line)
    nil
}

fn cell_sample(
    wave: str, R: Tensor[f64, [8, 16]], F: Tensor[f64, [8, 16]],
    tick: i64, span: i64, rate: f64
) -> f64 {
    let step = tick / span
    let local = tick % span
    let col = step % 16
    let bass_row = step % 8
    let lead_row = (bass_row + 3) % 8

    let rb = R[bass_row, col]
    let fb = F[bass_row, col]
    let rl = R[lead_row, col]
    let fl = F[lead_row, col]
    let accent = clamp01((rb + fb + rl + fl) * 0.55)

    let bass_note = note_from_cell(rb, fb, col)
    let lead_note = note_from_cell(rl, fl, col) + 12
    let bass_hz = midi_hz(bass_note)
    let lead_hz = midi_hz(lead_note)
    let t = local as f64 / rate

    let bass = osc(wave, t * bass_hz) * voice_env(local, span, rb, fb)
    let sub = osc("sin", t * bass_hz * 0.5) * 0.36
    let lead = osc("tri", t * lead_hz) * voice_env(local, span, rl, fl) * 0.32

    let on_downbeat = col % 4 == 0
    let on_backbeat = col % 8 == 4
    let on_hat = col % 2 == 1
    let k = if on_downbeat { kick(local, span, 0.80 + accent * 0.30, rate) } else { 0.0 }
    let s = if on_backbeat { snare(local, span, 0.58 + fb * 0.40) } else { 0.0 }
    let h = if on_hat { hat(local, span, 0.22 + fl * 0.25) } else { 0.0 }

    clamp_audio((bass * 0.45 + sub * 0.22 + lead * 0.24 + k + s + h) * 0.82)
}

fn print_raw(v: f64) -> nil {
    print(floor(v * 127.0) as i64)
    nil
}

fn main() -> nil {
    let wave = cli_arg("wave", "saw")
    let mode = cli_arg("mode", "scope")
    let use_variance = cli_flag("variance")
    let rate = 8000.0
    let span = 120
    let bars = 4
    let total_steps = 16 * bars
    let total_ticks = span * total_steps
    let stride = if mode == "raw" { 1 } else { 40 }

    print("demoniC ecological synth + beat machine")
    print("wave=" + wave + "  mode=" + mode + "  variance=" + to_str(use_variance))
    print("legend: rabbits=tonal energy  foxes=drums  @=accent conflict")
    print("")

    let mut R = init_rabbits()
    let mut F = init_foxes()

    let !tick = 0
    let !last_step = -1
    while tick < total_ticks {
        let step = tick / span
        if step != last_step {
            if step > 0 {
                let (R2, F2) = eco_step(R, F, use_variance)
                R = R2
                F = F2
            }
            if mode == "grid" {
                print_grid(R, F, step)
            }
            last_step = step
        }

        let v = cell_sample(wave, R, F, tick, span, rate)
        if mode == "raw" {
            print_raw(v)
        } else if mode == "scope" {
            print_scope(v)
        }
        tick = tick + stride
    }

    nil
}

# --- Tests ---

fn test_fract_positive() -> bool {
    # fract(3.7) = 3.7 - floor(3.7) = 3.7 - 3.0 = 0.7
    let v = fract(3.7)
    (v - 0.7) < 1e-9 && (v - 0.7) > -1e-9
}

fn test_fract_integer() -> bool {
    # fract(4.0) = 4.0 - floor(4.0) = 4.0 - 4.0 = 0.0
    let v = fract(4.0)
    v < 1e-9 && v > -1e-9
}

fn test_clamp01_below() -> bool {
    # values below 0 are clamped to 0
    clamp01(-0.5) == 0.0
}

fn test_clamp01_above() -> bool {
    # values above 1 are clamped to 1
    clamp01(1.5) == 1.0
}

fn test_clamp01_inside() -> bool {
    # values inside [0,1] pass through unchanged
    let v = clamp01(0.3)
    (v - 0.3) < 1e-9 && (v - 0.3) > -1e-9
}

fn test_clamp_audio_below() -> bool {
    # values below -1 are clamped to -1
    clamp_audio(-2.0) == -1.0
}

fn test_clamp_audio_above() -> bool {
    # values above 1 are clamped to 1
    clamp_audio(2.0) == 1.0
}

fn test_clamp_audio_passthrough() -> bool {
    # values inside [-1,1] pass through
    let v = clamp_audio(0.5)
    (v - 0.5) < 1e-9 && (v - 0.5) > -1e-9
}

fn test_midi_hz_a4() -> bool {
    # A4 = MIDI note 69 = 440 Hz by definition
    let v = midi_hz(69)
    (v - 440.0) < 1e-6 && (v - 440.0) > -1e-6
}

fn test_midi_hz_octave_up() -> bool {
    # A5 = MIDI note 81 = 880 Hz (one octave above A4; each octave doubles frequency)
    let v = midi_hz(81)
    (v - 880.0) < 1e-6 && (v - 880.0) > -1e-6
}

fn test_midi_hz_octave_down() -> bool {
    # A3 = MIDI note 57 = 220 Hz (one octave below A4; each octave halves frequency)
    let v = midi_hz(57)
    (v - 220.0) < 1e-6 && (v - 220.0) > -1e-6
}

fn test_osc_square_low() -> bool {
    # square wave: phase 0.25 < 0.5 => 1.0
    let v = osc("square", 0.25)
    (v - 1.0) < 1e-9 && (v - 1.0) > -1e-9
}

fn test_osc_square_high() -> bool {
    # square wave: phase 0.75 >= 0.5 => -1.0
    let v = osc("square", 0.75)
    (v - (-1.0)) < 1e-9 && (v - (-1.0)) > -1e-9
}

fn test_osc_tri_quarter() -> bool {
    # tri wave at 0.25: p < 0.5 so p*4 - 1 = 0.25*4 - 1 = 0.0
    let v = osc("tri", 0.25)
    v < 1e-9 && v > -1e-9
}

fn test_osc_saw_half() -> bool {
    # saw wave at 0.5 (default): p*2 - 1 = 0.5*2 - 1 = 0.0
    let v = osc("saw", 0.5)
    v < 1e-9 && v > -1e-9
}

fn test_osc_sin_quarter() -> bool {
    # sin wave at phase 0.25: sin(2*pi*0.25) = sin(pi/2) = 1.0
    let v = osc("sin", 0.25)
    (v - 1.0) < 1e-6 && (v - 1.0) > -1e-6
}

fn test_init_rabbits_total() -> bool {
    # By hand: diamond-shaped region centered at (6,12) with radius 7 in Manhattan distance.
    # Each cell (i,j) with dist=|i-6|+|j-12| < 7 contributes (7-dist)*0.12.
    # Summing over all qualifying cells gives exactly 19.56.
    let R = init_rabbits()
    let t = total(R)
    (t - 19.56) < 1e-9 && (t - 19.56) > -1e-9
}

fn test_init_foxes_total() -> bool {
    # By hand: diamond-shaped region centered at (1,3) with radius 5 in Manhattan distance.
    # Each cell (i,j) with dist=|i-1|+|j-3| < 5 contributes (5-dist)*0.16.
    # Summing over all qualifying cells gives exactly 11.2.
    let F = init_foxes()
    let t = total(F)
    (t - 11.2) < 1e-9 && (t - 11.2) > -1e-9
}

fn test_diffuse_conserves_total() -> bool {
    # diffuse uses reflecting boundary conditions (missing neighbors mirror as 'here').
    # This makes the operator doubly-stochastic: sum(Y) == sum(X) exactly.
    # Proof: sum_ij avg(i,j) == sum_ij X[i,j] because each X[a,b] appears in exactly
    # 4 neighbor-avg slots (including the reflected self-appearances at boundaries),
    # so the Laplacian term k*(avg-here) sums to zero across the grid.
    let R = init_rabbits()
    let before = total(R)
    let D = diffuse(R)
    let after = total(D)
    let diff = after - before
    let absdiff = if diff < 0.0 { -diff } else { diff }
    absdiff < 1e-9
}

fn test_render_cell_accent() -> bool {
    # r>0.36 AND f>0.36 => code 64 (@): both predator and prey high = accent conflict
    render_cell(0.5, 0.5) == 64
}

fn test_render_cell_rabbit_only() -> bool {
    # r>0.36, f not > 0.36 (but f > 0.09) => code 79 (O)
    render_cell(0.5, 0.1) == 79
}

fn test_render_cell_fox_only() -> bool {
    # r not > 0.36, f > 0.36 => code 88 (X)
    render_cell(0.1, 0.5) == 88
}

fn test_render_cell_empty() -> bool {
    # r <= 0.09, f <= 0.09 => code 46 (.)
    render_cell(0.01, 0.01) == 46
}

fn test_note_from_cell_basic() -> bool {
    # col=0 => scale=0; r=0.5 => lift=floor(0.5*12)=6; f=0.0 => bite=floor(0.0*5)=0
    # result = 36 + 0 + 6 - 0 = 42
    note_from_cell(0.5, 0.0, 0) == 42
}

fn test_note_from_cell_col1() -> bool {
    # col=1 => scale=3; r=0.0 => lift=0; f=0.0 => bite=0
    # result = 36 + 3 + 0 - 0 = 39
    note_from_cell(0.0, 0.0, 1) == 39
}
