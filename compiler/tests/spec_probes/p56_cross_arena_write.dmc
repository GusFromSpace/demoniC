# Probe 56 — MEMORY §3.1 (#442): mutating Vault data requires an explicit
# `vault { … }` block. The error case cannot live in a probe (probes must
# check clean), so this pins the LEGAL forms — the ones the corpus migration
# produced — and the checker unit tests pin the rejections.
fn main() -> nil {
    # 1. Per-run scratch belongs in the Forge: writes need no ceremony.
    let !scratch = forge.zeros[f32, [4]]
    scratch[0] = 1.0
    scratch -= forge.ones[f32, [4]]

    # 2. Long-lived Vault data is mutated inside an explicit vault block —
    #    the training-step idiom.
    let !weights = vault.ones[f32, [4]]
    vault {
        weights[0] = 0.5
        weights -= vault.ones[f32, [4]]
    }

    # 3. Reading Vault data anywhere is legal; only writes are scoped.
    scratch[1] = weights[2]

    # 4. A plain whole-`=` rebind is not a mutation. It re-tags the binding
    #    by its new value's arena, so later element writes are legal.
    let !w2 = vault.ones[f32, [4]]
    w2 = forge.zeros[f32, [4]]
    w2[0] = 1.0

    print(sum(scratch) + sum(weights) + sum(w2))
    nil
}

fn test_forge_scratch_writes() -> bool {
    let !s = forge.zeros[f32, [4]]
    s[0] = 2.0
    sum(s) == 2.0f32
}

fn test_vault_block_writes() -> bool {
    let !w = vault.zeros[f32, [4]]
    vault { w[1] = 3.0 }
    sum(w) == 3.0f32
}

fn test_rebind_retags_arena() -> bool {
    let !w = vault.ones[f32, [4]]
    w = forge.zeros[f32, [4]]
    w[0] = 5.0
    sum(w) == 5.0f32
}
