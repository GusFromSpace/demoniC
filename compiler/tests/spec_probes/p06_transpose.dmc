# Probe 06 — Spec §4.4 / OPERATORS §2.2: postfix transpose `'` on 2D tensor
fn main() -> nil {
    let m = [[1, 2, 3], [4, 5, 6]]   # Tensor[i64, [2, 3]]
    let t = m'                        # Tensor[i64, [3, 2]]
    print(t[0, 0]); print(" ")
    print(t[1, 1]); print(" ")
    print(t[2, 0]); print("\n")
    nil
}
