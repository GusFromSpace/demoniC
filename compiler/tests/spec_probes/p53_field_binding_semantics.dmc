# Probe 53 — SPEC §3.4 (#444): mut bindings from model fields.
# A SCALAR field binds by value (a snapshot, per the `let !y = x` copy rule);
# a TENSOR field binds as a live alias, and every write through the alias —
# element, whole-binding assignment, or compound op — reaches the field.
# Previously scalars aliased (snapshots tracked later writes) and whole-binding
# assignment silently rebound the local, which produced two no-op framebuffer
# mutators.
#
# #524 adds the other half of the rule: `let mut b = m.fb` is a VALUE binding
# for every field kind, tensor included, so the two mutable-binding spellings
# are not interchangeable here — and this is the only construct where they
# differ. (The alias itself is now honored by `dmc jit` too; the cross-backend
# cases live in tools/jit_probes.py, since this runner is interpreter-only.)
model Machine {
    !sp: i64
    !fb: Tensor[i64, [4]]

    fn enter(self) -> bool {
        let !base = self.sp        # snapshot: must hold 2 forever
        self.sp = 9
        base == 2
    }

    fn clear!(self, v: i64) -> nil {
        let !b = self.fb
        b = forge.ones[i64, [4]] .* v    # whole-binding write reaches the field
        nil
    }
}

fn main() -> nil {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    print(m.enter() as str)
    m.clear!(5)
    print(m.fb[3])
    nil
}

fn test_scalar_snapshot() -> bool {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    m.enter()
}

fn test_whole_binding_write_reaches_field() -> bool {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    m.clear!(5)
    m.fb[0] == 5
}

fn test_element_write_still_reaches_field() -> bool {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    let !b = m.fb
    b[2] = 8
    m.fb[2] == 8
}

# #524: the `mut` spelling is a value binding — the write stays in the local.
fn test_mut_spelling_copies_the_field() -> bool {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    let mut b = m.fb
    b[2] = 8
    m.fb[2] == 0 && b[2] == 8
}

# #524: a plain `let` from a tensor field is a snapshot in the other direction —
# a later write to the FIELD is not visible through the binding.
fn test_immutable_bind_snapshots_the_field() -> bool {
    let !m = Machine { sp: 2, fb: forge.zeros[i64, [4]] }
    let b = m.fb
    m.fb[1] = 6
    b[1] == 0 && m.fb[1] == 6
}
